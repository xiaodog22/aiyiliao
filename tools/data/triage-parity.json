      "rules": [
        "bleeding",
        "trauma"
      ]
    },
    {
      "id": "rf-29",
      "text": "肚子硬得像板一样疼得受不了",
      "emergency": true,
      "rules": [
        "acute_abdomen"
      ]
    },
    {
