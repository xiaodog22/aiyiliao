  "entries": [
    {
      "id": "rf-01",
      "text": "胸口压榨一样疼，还出汗",
      "emergency": true,
      "rules": [
        "chest_pain"
      ]
    },
    {
      "id": "rf-02",
      "text": "早上起来口角歪斜，说话不清",
      "emergency": true,
      "rules": [
        "stroke"
      ]
    },
    {
      "id": "rf-03",
      "text": "喘不上气，坐着都憋得慌",
      "emergency": true,
      "rules": [
        "dyspnea"
      ]
    },
    {
      "id": "rf-04",
      "text": "突然晕倒，叫不醒",
      "emergency": true,
      "rules": [
        "consciousness"
      ]
    },
    {
      "id": "rf-05",
      "text": "呕血两次，黑便",
      "emergency": true,
      "rules": [
        "bleeding"
      ]
    },
    {
      "id": "rf-06",
      "text": "突然剧烈头痛，脖子发硬",
      "emergency": true,
      "rules": [
        "severe_headache"
      ]
    },
    {
      "id": "rf-07",
      "text": "吃了海鲜全身皮疹，喉咙发紧呼吸困难",
      "emergency": true,
      "rules": [
        "anaphylaxis",
        "dyspnea"
      ]
    },
    {
      "id": "rf-08",
      "text": "误服了农药",
      "emergency": true,
      "rules": [
        "poisoning"
      ]
    },
    {
      "id": "rf-09",
      "text": "车祸外伤，骨头都露出来了",
      "emergency": true,
      "rules": [
        "trauma"
      ]
    },
    {
      "id": "rf-10",
      "text": "肚子硬得像木板，一按就剧痛",
      "emergency": true,
      "rules": [
        "acute_abdomen"
      ]
    },
    {
      "id": "rf-11",
      "text": "三个月婴儿发热38度",
      "emergency": true,
      "rules": [
        "infant_fever"
      ]
    },
    {
      "id": "rf-12",
      "text": "怀孕7个月，阴道出血伴肚子痛",
      "emergency": true,
      "rules": [
        "pregnancy_emergency"
      ]
    },
    {
      "id": "rf-13",
      "text": "不想活了，想死",
      "emergency": true,
      "rules": [
        "self_harm"
      ]
    },
    {
      "id": "rf-14",
      "text": "大面积烧伤，脸也烧到了",
      "emergency": true,
      "rules": [
        "severe_burn"
      ]
    },
    {
      "id": "rf-15",
      "text": "发烧39度还抽搐",
      "emergency": true,
      "rules": [
        "consciousness",
        "high_fever_convulsion"
      ]
    },
    {
      "id": "rf-16",
      "text": "胸口像压了块石头，冷汗直流",
      "emergency": true,
      "rules": [
        "chest_pain"
      ]
    },
    {
      "id": "rf-17",
      "text": "说话含糊，半边身子没劲",
      "emergency": true,
      "rules": [
        "stroke"
      ]
    },
    {
      "id": "rf-18",
      "text": "憋得慌，躺下更喘",
      "emergency": true,
      "rules": [
        "dyspnea"
      ]
    },
    {
      "id": "rf-19",
      "text": "突然人事不省",
      "emergency": true,
      "rules": [
        "consciousness"
      ]
    },
    {
      "id": "rf-20",
