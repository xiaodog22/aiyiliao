      "emergency": true,
      "rules": [
        "bleeding"
      ]
    },
    {
      "id": "rf-21",
      "text": "误服了农药怎么办",
      "emergency": true,
      "rules": [
        "poisoning"
      ]
    },
    {
      "id": "rf-22",
      "text": "孩子三个月大，发烧39度",
      "emergency": true,
      "rules": [
        "infant_fever"
      ]
    },
    {
      "id": "rf-23",
      "text": "怀孕八个月，下面出血",
