/* ============================================================================
   packageNav/pages/nav —— 院内导航（患者端 16-院内导航）

   逐项尺寸取自设计稿 1391×3014（750rpx 宽，1rpx ≈ 1.8547px）实测：
     页面左右留白 20rpx · 顶部 24rpx · 卡间距 24rpx
     信息卡 148rpx（内边距 30/44，标签 28rpx，值 34rpx，标签→值 12rpx）
     平面图卡 696rpx（内边距 20rpx，画布舞台 656rpx）· 楼层胶囊 50rpx · 圆形按钮 64rpx
     路线卡 466rpx（标题 40rpx，步骤 34rpx/圆形编号 38rpx，分割线通栏，语音行 101rpx）

   色彩纪律：只用 app.wxss 令牌。
   ⚠️ 尺寸口径：手机档写 rpx；文件末尾的 ≥600px 断点把**每一处** rpx 折成 px（÷2），
      与前八页同一口径。改样式后必须同步核对断点段。
   ============================================================================ */

/* ============ 页面骨架 ============ */
.nvpage {
  padding: 24rpx 20rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--bg);
}

/* ============ ① 路线信息卡 ============
   设计实测：卡高 148rpx、内边距上 30 下 30、左右 44；
   标签 28rpx 弱灰、值 34rpx/700 深蓝，第三栏「到」为品牌蓝，标签→值 12rpx。 */
.nvi {
  display: flex;
  align-items: flex-start;
  padding: 30rpx 44rpx;
  margin-bottom: 24rpx;
  border-radius: var(--radius-lg);
}

.nvi-cell {
  min-width: 0;
}

/* 三栏宽度按实测（当前楼层栏 216rpx / 从栏 200rpx / 到栏吃满剩余）；
   ⚠️ 不能三等分：6 个字的科室名（呼吸内科门诊）在 1/3 栏里放不下会被省略号截断。 */
.nvi-c1 {
  flex: 0 0 216rpx;
  width: 216rpx;
}

.nvi-c2 {
  flex: 0 0 200rpx;
  width: 200rpx;
}

.nvi-c3 {
  flex: 1;
  min-width: 0;
}

.nvi-k {
  font-size: calc(var(--font-caption) + 4rpx);
  color: var(--text-weak);
  line-height: 1.2;
}

.nvi-v {
  margin-top: 12rpx;
  font-size: var(--font-h2);
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 「到」：品牌蓝高亮（设计稿唯一蓝色文字 = 可交互信号） */
.nvi-v-to {
  color: var(--primary);
}

/* 未选目的地：放大镜 + 引导词（不是设计稿的截图态，但这是"没选"时该有的样子） */
.nvi-v-empty {
  display: flex;
  align-items: center;
  color: var(--text-weak);
}

.nvi-pick-ic {
  width: 30rpx;
  height: 30rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.nvi-pick-t {
  font-size: calc(var(--font-caption) + 4rpx);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ============ ② 平面图卡 ============
   设计实测：白卡内边距 20rpx，卡内"图纸"区域（浅灰蓝底）占满剩余空间；
   图纸四角圆角 24rpx。 */
.nvm {
  padding: 20rpx;
  margin-bottom: 24rpx;
  border-radius: var(--radius-lg);
}

.nvm-stage {
  position: relative;
  height: 656rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--bg);
}

.nvm-canvas {
  display: block;
  width: 100%;
  height: 100%;
}

/* ---- 楼层胶囊（左下角）----
   设计实测：204×50rpx，左 20rpx、底 19rpx，全圆角白底 + 极弱阴影；
   文案 28rpx/700 深蓝，右侧一个 8×20rpx 浅灰竖条（设计稿的"可展开"暗示）。 */
.nvm-floor {
  position: absolute;
  left: 20rpx;
  bottom: 19rpx;
  display: flex;
  align-items: center;
  height: 50rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: var(--card);
  box-shadow: var(--shadow-card);
}

.nvm-floor-on {
  box-shadow: 0 4rpx 20rpx rgba(11, 110, 248, 0.18);
}

.nvm-floor-t {
  font-size: calc(var(--font-caption) + 4rpx);
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.2;
  white-space: nowrap;
}

.nvm-floor-h {
  width: 8rpx;
  height: 20rpx;
  margin-left: 14rpx;
  border-radius: 4rpx;
  background: var(--border);
}

/* ---- 楼层 tab 面板：横向可滚动，选中高亮蓝底白字 ---- */
.nvm-floors {
  position: absolute;
  left: 20rpx;
  bottom: 81rpx;
  right: 20rpx;
  padding: 12rpx 14rpx;
  border-radius: var(--radius-md);
  background: var(--card);
  box-shadow: 0 6rpx 24rpx rgba(11, 110, 248, 0.16);
}

.nvm-floors-scroll {
  white-space: nowrap;
}

.nvm-floor-tab {
  display: inline-block;
  min-width: 92rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 20rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: calc(var(--font-caption) + 4rpx);
  font-weight: 600;
  color: var(--text-sub);
  background: var(--bg);
  box-sizing: border-box;
}

.nvm-floor-tab-on {
  color: #FFFFFF;
  background: var(--primary);
}

/* ---- 非 1F：底图未录入的说明层（覆盖在画布上，不伪造平面图）---- */
.nvm-nomap {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  padding: 32rpx 28rpx;
  border-radius: var(--radius-md);
  background: var(--card);
  box-shadow: var(--shadow-card);
  text-align: center;
}

.nvm-nomap-ic {
  width: 56rpx;
  height: 56rpx;
  opacity: 0.7;
}

.nvm-nomap-t {
  margin-top: 12rpx;
  font-size: calc(var(--font-caption) + 4rpx);
  font-weight: 700;
  color: var(--text-main);
}

.nvm-nomap-d {
  margin-top: 10rpx;
  font-size: var(--font-caption);
  color: var(--text-sub);
  line-height: 1.5;
}

.nvm-nomap-btn {
  display: inline-block;
  margin-top: 20rpx;
  padding: 0 32rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: #FFFFFF;
  font-size: calc(var(--font-caption) + 4rpx);
  font-weight: 600;
}

/* ---- 右侧浮动按钮组：放大 / 缩小 / 回到当前位置 ----
   设计实测：圆形 64rpx、白色、极弱阴影，右内缩 16rpx、底内缩 23rpx、间距 30rpx。
   ⚠️ 设计稿只有 +/−（两个）；按需求补了第三个"回到当前位置"，整组因此上移。 */
.nvm-tools {
  position: absolute;
  right: 16rpx;
  bottom: 23rpx;
  display: flex;
  flex-direction: column;
}

.nvm-btn {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 30rpx;
  border-radius: 50%;
  background: var(--card);
  box-shadow: 0 2rpx 12rpx rgba(20, 38, 76, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}

.nvm-btn:last-child {
  margin-bottom: 0;
}

.nvm-btn:active {
  background: var(--accent-soft);
}

/* +/− 用纯 CSS 描边画（不用字符、不用 emoji，随缩放也清晰） */
.nvm-btn-icon {
  position: relative;
  width: 26rpx;
  height: 26rpx;
}

.nvm-btn-plus::before,
.nvm-btn-plus::after,
.nvm-btn-minus::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  background: var(--text-main);
  border-radius: 2rpx;
  transform: translate(-50%, -50%);
}

.nvm-btn-plus::before,
.nvm-btn-minus::before {
  width: 26rpx;
  height: 3rpx;
}

.nvm-btn-plus::after {
  width: 3rpx;
  height: 26rpx;
}

/* 回到当前位置：地图针图标（比 +/− 略小，视觉重量对齐） */
.nvm-btn-ic {
  width: 32rpx;
  height: 32rpx;
}

/* ============ ③ 路线指引卡 ============
   设计实测：内边距上 32rpx、左右 32rpx；标题 40rpx/700；标题→第一步 37rpx；
   步骤行距 81.7rpx（行高 43.2 + 间隙 38）；末步→分割线 39rpx；
   分割线通栏；语音行高 101rpx、内容居中。
   ⚠️ 分割线要通栏，所以卡本身不加左右内边距，由子块各自加。 */
.nvr {
  padding: 32rpx 0 0;
  margin-bottom: 0;
  border-radius: var(--radius-lg);
}

.nvr-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 32rpx;
}

.nvr-title {
  font-size: var(--font-title);
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.2;
}

.nvr-meta {
  font-size: var(--font-caption);
  color: var(--text-sub);
  line-height: 1.2;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.nvr-steps {
  display: flex;
  flex-direction: column;
  padding: 0 32rpx;
  margin-top: 37rpx;
}

.nvr-step {
  display: flex;
  align-items: flex-start;
  margin-bottom: 38rpx;
}

.nvr-step:last-child {
  margin-bottom: 0;
}

/* 蓝色圆形数字编号：38rpx */
.nvr-n {
  width: 38rpx;
  height: 38rpx;
  line-height: 38rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #FFFFFF;
  font-size: var(--font-caption);
  font-weight: 700;
  text-align: center;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.nvr-t {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  font-size: calc(var(--font-h2) + 2rpx);
  color: var(--text-main);
  line-height: 1.2;
}

/* 换层提示（2F/3F 科室）：浅蓝底提示条 */
.nvr-tip {
  display: flex;
  align-items: flex-start;
  margin: 28rpx 32rpx 0;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-md);
  background: var(--accent-soft);
}

.nvr-tip-ic {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
  margin-top: 6rpx;
  flex-shrink: 0;
}

.nvr-tip-t {
  flex: 1;
  min-width: 0;
  font-size: var(--font-caption);
  color: var(--text-sub);
  line-height: 1.5;
}

/* 未选目的地：空态（设计稿是"已选"态，这里给出该有的引导） */
.nvr-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 32rpx 4rpx;
  text-align: center;
}

.nvr-empty-ic {
  width: 64rpx;
  height: 64rpx;
  opacity: 0.6;
}

.nvr-empty-t {
  margin-top: 14rpx;
  font-size: calc(var(--font-caption) + 4rpx);
  font-weight: 600;
  color: var(--text-main);
}

.nvr-empty-d {
  margin-top: 8rpx;
  font-size: var(--font-caption);
  color: var(--text-sub);
  line-height: 1.5;
}

.nvr-empty-btn {
  margin-top: 20rpx;
  padding: 0 40rpx;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: #FFFFFF;
  font-size: calc(var(--font-caption) + 4rpx);
  font-weight: 600;
}

/* 通栏分割线 */
.nvr-line {
  height: 1rpx;
  margin-top: 39rpx;
  background: var(--border);
}

/* 语音播报行：101rpx 高、图标 + 文案居中、品牌蓝 */
.nvr-voice {
  height: 101rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nvr-voice-ic {
  width: 34rpx;
  height: 34rpx;
  margin-right: 12rpx;
}

.nvr-voice-t {
  font-size: calc(var(--font-body) + 2rpx);
  font-weight: 600;
  color: var(--primary);
  line-height: 1.2;
}

.nvr-voice-on .nvr-voice-t {
  color: var(--text-sub);
}

/* ============ 目的地选择弹层 ============ */
.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 55;
  background: rgba(20, 38, 76, 0.42);
}

.nvp {
  z-index: 60;
  display: flex;
  flex-direction: column;
  max-height: 78vh;
}

.nvp-head {
  position: relative;
}

.nvp-title {
  padding-bottom: 16rpx;
}

.nvp-x {
  position: absolute;
  right: 0;
  top: 0;
  padding: 6rpx 4rpx 6rpx 20rpx;
  font-size: var(--font-caption);
  color: var(--text-sub);
  line-height: 1.2;
}

/* 搜索行：输入框 + 搜索按钮 */
.nvp-search {
  display: flex;
  align-items: center;
  height: 80rpx;
  padding: 0 8rpx 0 24rpx;
  border-radius: 999rpx;
  background: var(--bg);
  box-sizing: border-box;
}

.nvp-search-ic {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.nvp-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  margin-left: 12rpx;
  font-size: calc(var(--font-caption) + 4rpx);
  color: var(--text-main);
}

.nvp-ph {
  color: var(--text-weak);
  font-size: var(--font-caption);
}

.nvp-search-btn {
  flex-shrink: 0;
  width: 112rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 999rpx;
  background: var(--primary);
  color: #FFFFFF;
  font-size: calc(var(--font-caption) + 2rpx);
  font-weight: 600;
}

/* 常用词 */
.nvp-hot {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.nvp-hot-k {
  font-size: var(--font-caption);
  color: var(--text-weak);
  margin-right: 12rpx;
}

.nvp-hot-c {
  margin: 0 12rpx 8rpx 0;
  padding: 0 20rpx;
  height: 52rpx;
  line-height: 52rpx;
  border-radius: 999rpx;
  background: var(--accent-soft);
  color: var(--primary);
  font-size: var(--font-caption);
}

/* 分类 chip */
.nvp-cats {
  display: flex;
  align-items: center;
  margin-top: 4rpx;
  padding-bottom: 4rpx;
  white-space: nowrap;
  overflow-x: auto;
}

.nvp-cat {
  flex-shrink: 0;
  margin-right: 16rpx;
  padding: 0 26rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 999rpx;
  background: var(--bg);
  color: var(--text-sub);
  font-size: var(--font-caption);
}

.nvp-cat-on {
  background: var(--primary);
  color: #FFFFFF;
  font-weight: 600;
}

.nvp-err {
  margin-top: 12rpx;
}

/* 结果列表：可滚动，弹层最大 78vh */
.nvp-list {
  flex: 1;
  min-height: 260rpx;
  max-height: 46vh;
  margin-top: 8rpx;
}

.nvp-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.nvp-row-ic {
  width: 56rpx;
  height: 56rpx;
  margin-right: 20rpx;
  border-radius: var(--radius-md);
  background: var(--accent-soft);
  flex-shrink: 0;
}

.nvp-row-main {
  flex: 1;
  min-width: 0;
}

.nvp-row-name {
  font-size: calc(var(--font-caption) + 4rpx);
  font-weight: 600;
  color: var(--text-main);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nvp-row-sub {
  margin-top: 4rpx;
  font-size: var(--font-caption);
  color: var(--text-sub);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nvp-row-dist {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: var(--font-caption);
  color: var(--text-weak);
}

.nvp-none {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0;
}

.nvp-none-ic {
  width: 56rpx;
  height: 56rpx;
  opacity: 0.5;
}

.nvp-none-t {
  margin-top: 12rpx;
  font-size: calc(var(--font-caption) + 4rpx);
  font-weight: 600;
  color: var(--text-main);
}

.nvp-none-d {
  margin-top: 6rpx;
  font-size: var(--font-caption);
  color: var(--text-sub);
}

/* 列表底部留白：最后一行不贴弹层边缘 */
.nvp-pad {
  height: 24rpx;
}

/* ============================================================================
   ≥600px：rpx → px（÷2）
   ⚠️ 基础段里**每一处**含 rpx 的选择器都在此重新声明，避免宽屏上 rpx 被等比放大。
   ============================================================================ */
@media (min-width: 600px) {
  .nvpage {
    max-width: 375px;
    margin: 0 auto;
    padding: 12px 10px calc(12px + env(safe-area-inset-bottom));
  }

  .nvi {
    padding: 15px 22px;
    margin-bottom: 12px;
  }

  .nvi-c1 {
    flex: 0 0 108px;
    width: 108px;
  }

  .nvi-c2 {
    flex: 0 0 100px;
    width: 100px;
  }

  /* ⚠️ calc(… + Nrpx) 里的 rpx 在宽屏上同样会被等比放大，必须一并改写成 px（÷2） */
  .nvi-k,
  .nvi-pick-t {
    font-size: calc(var(--font-caption) + 2px);
  }

  .nvi-v {
    margin-top: 6px;
  }

  .nvi-pick-ic {
    width: 15px;
    height: 15px;
    margin-right: 4px;
  }

  .nvm {
    padding: 10px;
    margin-bottom: 12px;
  }

  .nvm-stage {
    height: 328px;
  }

  .nvm-floor {
    left: 10px;
    bottom: 9.5px;
    height: 25px;
    padding: 0 11px;
  }

  .nvm-floor-on {
    box-shadow: 0 2px 10px rgba(11, 110, 248, 0.18);
  }

  .nvm-floor-h {
    width: 4px;
    height: 10px;
    margin-left: 7px;
    border-radius: 2px;
  }

  .nvm-floor-t,
  .nvm-floor-tab {
    font-size: calc(var(--font-caption) + 2px);
  }

  .nvm-floors {
    left: 10px;
    right: 10px;
    bottom: 40.5px;
    padding: 6px 7px;
    box-shadow: 0 3px 12px rgba(11, 110, 248, 0.16);
  }

  .nvm-floor-tab {
    min-width: 46px;
    height: 30px;
    line-height: 30px;
    padding: 0 10px;
    margin-right: 7px;
  }

  .nvm-nomap {
    left: 12px;
    right: 12px;
    padding: 16px 14px;
  }

  .nvm-nomap-ic {
    width: 28px;
    height: 28px;
  }

  .nvm-nomap-t {
    margin-top: 6px;
  }

  .nvm-nomap-d {
    margin-top: 5px;
  }

  .nvm-nomap-btn {
    margin-top: 10px;
    padding: 0 16px;
    height: 32px;
    line-height: 32px;
  }

  .nvm-nomap-t,
  .nvm-nomap-btn {
    font-size: calc(var(--font-caption) + 2px);
  }

  .nvm-tools {
    right: 8px;
    bottom: 11.5px;
  }

  .nvm-btn {
    width: 32px;
    height: 32px;
    margin-bottom: 15px;
    box-shadow: 0 1px 6px rgba(20, 38, 76, 0.12);
  }

  .nvm-btn-icon {
    width: 13px;
    height: 13px;
  }

  .nvm-btn-plus::before,
  .nvm-btn-plus::after,
  .nvm-btn-minus::before {
    border-radius: 1px;
  }

  .nvm-btn-plus::before,
  .nvm-btn-minus::before {
    width: 13px;
    height: 1.5px;
  }

  .nvm-btn-plus::after {
    width: 1.5px;
    height: 13px;
  }

  .nvm-btn-ic {
    width: 16px;
    height: 16px;
  }

  .nvr {
    padding-top: 16px;
  }

  .nvr-head {
    padding: 0 16px;
  }

  .nvr-meta {
    margin-left: 8px;
  }

  .nvr-steps {
    padding: 0 16px;
    margin-top: 18.5px;
  }

  .nvr-step {
    margin-bottom: 19px;
  }

  .nvr-n {
    width: 19px;
    height: 19px;
    line-height: 19px;
    margin-top: 1px;
  }

  .nvr-t {
    margin-left: 12px;
    font-size: calc(var(--font-h2) + 1px);
  }

  .nvr-tip {
    margin: 14px 16px 0;
    padding: 10px 12px;
  }

  .nvr-tip-ic {
    width: 14px;
    height: 14px;
    margin-right: 6px;
    margin-top: 3px;
  }

  .nvr-empty {
    padding: 14px 16px 2px;
  }

  .nvr-empty-ic {
    width: 32px;
    height: 32px;
  }

  .nvr-empty-t {
    margin-top: 7px;
  }

  .nvr-empty-d {
    margin-top: 4px;
  }

  .nvr-empty-btn {
    margin-top: 10px;
    padding: 0 20px;
    height: 34px;
    line-height: 34px;
  }

  .nvr-empty-t,
  .nvr-empty-btn {
    font-size: calc(var(--font-caption) + 2px);
  }

  .nvr-line {
    height: 1px;
    margin-top: 19.5px;
  }

  .nvr-voice {
    height: 50.5px;
  }

  .nvr-voice-ic {
    width: 17px;
    height: 17px;
    margin-right: 6px;
  }

  .nvr-voice-t {
    font-size: calc(var(--font-body) + 1px);
  }

  /* 弹层在宽屏下与主列同宽（.sheet 是 left/right:0 固定定位，不覆盖会横贯整个窗口） */
  .nvp {
    left: 50%;
    right: auto;
    width: 375px;
    transform: translateX(-50%);
  }

  .nvp-title {
    padding-bottom: 8px;
  }

  .nvp-x {
    padding: 3px 2px 3px 10px;
  }

  .nvp-search {
    height: 40px;
    padding: 0 4px 0 12px;
  }

  .nvp-search-ic {
    width: 16px;
    height: 16px;
  }

  .nvp-input {
    height: 40px;
    margin-left: 6px;
  }

  .nvp-search-btn {
    width: 56px;
    height: 30px;
    line-height: 30px;
    font-size: calc(var(--font-caption) + 1px);
  }

  .nvp-input {
    font-size: calc(var(--font-caption) + 2px);
  }

  .nvp-row-name,
  .nvp-none-t {
    font-size: calc(var(--font-caption) + 2px);
  }

  .nvp-hot {
    margin-top: 9px;
  }

  .nvp-hot-k {
    margin-right: 6px;
  }

  .nvp-hot-c {
    margin: 0 6px 4px 0;
    padding: 0 10px;
    height: 26px;
    line-height: 26px;
  }

  .nvp-cats {
    margin-top: 2px;
    padding-bottom: 2px;
  }

  .nvp-cat {
    margin-right: 8px;
    padding: 0 13px;
    height: 30px;
    line-height: 30px;
  }

  .nvp-err {
    margin-top: 6px;
  }

  .nvp-list {
    min-height: 130px;
    max-height: 230px;
    margin-top: 4px;
  }

  .nvp-row {
    padding: 10px 0;
  }

  .nvp-row-ic {
    width: 28px;
    height: 28px;
    margin-right: 10px;
  }

  .nvp-row-sub {
    margin-top: 2px;
  }

  .nvp-row-dist {
    margin-left: 8px;
  }

  .nvp-none {
    padding: 24px 0;
  }

  .nvp-none-ic {
    width: 28px;
    height: 28px;
  }

  .nvp-none-t {
    margin-top: 6px;
  }

  .nvp-none-d {
    margin-top: 3px;
  }

  .nvp-pad {
    height: 12px;
  }
}
