    "pages/profile/profile",
    "pages/tv/cast/cast",
    "pages/triage/triage",
    "pages/triage/result/result",
    "pages/appointment/appointment",
    "pages/consult/consult",
    "pages/consult/picker/picker",
    "pages/profile/records/records",
    "pages/profile/health-records/health-records",
    "pages/profile/consultations/consultations",
    "pages/profile/family/family",
    "pages/profile/personal-info/personal-info",
    "pages/profile/settings/settings",
    "pages/profile/voice-settings/voice-settings",
