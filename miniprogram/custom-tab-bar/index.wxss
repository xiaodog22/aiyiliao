/* custom-tab-bar —— 自绘底部导航 */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 100rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #FFFFFF;
  border-top: 1rpx solid #E3EAF5;
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 8rpx 0;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
}

.tab-text {
  font-size: 22rpx;
  color: #8A9BB8;
  line-height: 1.2;
}

.tab-item.active .tab-text {
  color: #0B6EF8;
  font-weight: 500;
}

/* 适老模式：放大图标和文字，增加触控区域 */
.tab-elder {
  padding: 16rpx 0;
}
.tab-elder .tab-icon {
  width: 56rpx;
  height: 56rpx;
}
.tab-elder .tab-text {
  font-size: 28rpx;
  font-weight: 500;
}
