/* pages/triage/result —— 智能导诊报告
   2026-10-18 批次 B：与 pages/triage 同套视觉语言对齐——
   · 卡片保持全局 .card（白底 / 圆角 / 极弱阴影）；图标底板沿用圆角方形浅蓝底；
   · 危险语义（急诊卡 / 120 按钮 / 红旗标签）全部收口到 app.wxss 令牌
     （--danger-soft / --danger-border / --danger-text / --accent-red），删除页内 #hex；
   · 辅助文字按项目既有口径提到「≥24rpx 且不浅于 --text-sub」，保证可读性与对比度。
   ⚠️ 本页无独立设计参考图（29 张设计图中无导诊报告页），故不虚构版式，
     只与导诊页/首页保持同一套视觉语言与色彩纪律。
   ⚠️ 仅改样式：报告读取（storage）、TTS 播报、120 拨打、跳挂号/导航、隐私清除均未变。 */

/* 空态 */
.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 72rpx 40rpx;
  text-align: center;
}

.empty-card .ic-lg { opacity: 0.35; }

.empty-t {
  margin-top: 20rpx;
  font-size: var(--font-h2);
  font-weight: 700;
  color: var(--text-main);
}

.empty-s {
  margin-top: 10rpx;
  font-size: calc(var(--font-caption) + 2rpx);
  color: var(--text-sub);
  line-height: 1.7;
}

.empty-btn { margin-top: 32rpx; width: 100%; }

/* ① 分级卡 */
.rk-card {
  border-left: 10rpx solid var(--primary);
}

.rk-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rk-badge { font-size: var(--font-caption); font-weight: 700; }

.rk-window {
  font-size: calc(var(--font-caption) + 2rpx);
  color: var(--text-sub);
}

.rk-advice {
  margin-top: 16rpx;
  font-size: var(--font-body);
  color: var(--text-main);
  line-height: 1.7;
}

.rk-ops {
  display: flex;
  margin-top: 20rpx;
}

.rk-op {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: var(--accent-soft);
  color: var(--primary);
  font-size: calc(var(--font-caption) + 2rpx);
  font-weight: 600;
}

.rk-op:active { background: var(--accent-press); }
.rk-op .ic-sm { margin-right: 8rpx; }

/* ② 急诊预警（红旗命中 → 真实高风险，保持红色语义） */
.emg-card {
  background: var(--danger-soft);
  border: 2rpx solid var(--danger-border);
  border-left: 10rpx solid var(--accent-red);
}

.emg-head {
  display: flex;
  align-items: center;
}

.emg-head .ic-md { margin-right: 12rpx; }

.emg-title {
  font-size: var(--font-h2);
  font-weight: 700;
  color: var(--danger-text);
}

.emg-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.emg-tag {
  padding: 4rpx 18rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 999rpx;
  background: var(--card);
  border: 2rpx solid var(--danger-border);
  color: var(--danger-text);
  font-size: var(--font-caption);
  font-weight: 600;
}

.emg-action {
  margin-top: 6rpx;
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--danger-text);
  line-height: 1.7;
}

.emg-ops {
  display: flex;
  margin-top: 20rpx;
}

.emg-op { flex: 1; }

.emg-op-2 { margin-left: 16rpx; }

.btn-emg {
  background: var(--accent-red);
  color: #FFFFFF;
}

.btn-emg:active { background: var(--danger-text); }
.btn-emg .ic-sm { margin-right: 8rpx; }

/* ③ 推荐科室 */
.dept-head {
  display: flex;
  align-items: center;
}

.dept-icon-badge {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: var(--accent-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.dept-main { flex: 1; min-width: 0; }

.dept-label {
  font-size: calc(var(--font-caption) + 2rpx);
  color: var(--text-sub);
}

.dept-name {
  margin-top: 2rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--primary-dark);
  line-height: 1.3;
}

.dept-floor {
  margin-top: 2rpx;
  font-size: calc(var(--font-caption) + 2rpx);
  color: var(--text-sub);
}

.dept-intro {
  margin-top: 18rpx;
  font-size: calc(var(--font-caption) + 2rpx);
  color: var(--text-sub);
  line-height: 1.7;
}

.dept-conf {
  margin-top: 10rpx;
  font-size: calc(var(--font-caption) + 2rpx);
  color: var(--text-sub);
}

.dept-basis {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: var(--radius-sm);
  background: var(--bg);
}

.dept-basis-title {
  font-size: var(--font-caption);
  font-weight: 700;
  color: var(--text-sub);
  margin-bottom: 8rpx;
}

.dept-basis-item {
  font-size: var(--font-caption);
  color: var(--text-sub);
  line-height: 1.7;
}

.dept-alt {
  margin-top: 14rpx;
  font-size: calc(var(--font-caption) + 2rpx);
  color: var(--text-sub);
  line-height: 1.6;
}

.dept-alt-k { color: var(--text-sub); }

.dept-ops {
  display: flex;
  margin-top: 24rpx;
}

.dept-op { flex: 1; }
.dept-op + .dept-op { margin-left: 16rpx; }

.dept-nav-hint {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  font-size: calc(var(--font-caption) + 2rpx);
  color: var(--text-sub);
}

.dept-nav-hint .ic-xs { margin-right: 8rpx; flex-shrink: 0; }

/* ④ 症状回顾 */
.card-title-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  vertical-align: middle;
}

.sym-slots {
  margin-top: 12rpx;
  padding: 18rpx 20rpx;
  border-radius: var(--radius-sm);
  background: var(--accent-soft);
}

.sym-slots-title,
.sym-raw-title {
  font-size: var(--font-caption);
  font-weight: 700;
  color: var(--text-sub);
  margin-bottom: 8rpx;
}

.sym-slots-text {
  font-size: var(--font-body);
  color: var(--primary-dark);
  line-height: 1.7;
}

.sym-raw { margin-top: 18rpx; }

.sym-raw-text {
  font-size: calc(var(--font-caption) + 2rpx);
  color: var(--text-main);
  line-height: 1.8;
}

/* ⑤ 下一步 */
.next-item {
  font-size: var(--font-body);
  color: var(--text-main);
  line-height: 1.8;
}

/* ⑥ 合规与隐私 */
.law-card {
  background: var(--bg);
  box-shadow: none;
}

.law-title {
  display: flex;
  align-items: center;
  font-size: var(--font-caption);
  font-weight: 700;
  color: var(--text-sub);
}

.law-title .ic-xs { margin-right: 8rpx; }

.law-text {
  margin-top: 10rpx;
  font-size: calc(var(--font-caption) + 2rpx);
  color: var(--text-sub);
  line-height: 1.8;
}

.law-ops {
  display: flex;
  margin-top: 16rpx;
}

.law-op {
  display: flex;
  align-items: center;
  min-height: 80rpx;
  padding: 0 24rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: var(--card);
  border: 2rpx solid var(--border);
  color: var(--text-sub);
  font-size: calc(var(--font-caption) + 2rpx);
  box-sizing: border-box;
}

.law-op:active { background: var(--accent-soft); }

.act-btn { margin-bottom: 16rpx; }
