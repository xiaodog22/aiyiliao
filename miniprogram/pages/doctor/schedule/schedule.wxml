<!--
  pages/doctor/schedule —— 线上问诊设置（医生端）
  ⚠️ 这里配置的是**线上问诊**接诊能力（在线状态 + 每周可接诊时段 + 每时段人数），
      不是线下门诊号源；患者端「选择医生」会同步展示在线状态。
  ⚠️ 时段与人数全部来自服务端（GET /api/v1/doctor/schedule），客户端只做编辑与保存。
-->
<view class="page theme-{{theme}} ds-page" style="padding-top: {{navH}}px;">

  <view class="ds-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="ds-nav-bar">
      <view class="ds-nav-back" bindtap="onBack" hover-class="ds-hover" aria-role="button" aria-label="返回">
        <image class="ds-nav-back-ic" src="{{icons.chevronLeft}}" />
      </view>
      <view class="ds-nav-title">线上问诊设置</view>
    </view>
  </view>

  <offline-bar />

  <!-- 在线接诊开关 -->
  <view class="ds-online">
    <view class="ds-online-body">
      <view class="ds-online-title">在线接诊状态</view>
      <view class="ds-online-sub">开启后患者可在「在线问诊」中选择您；关闭后不再接收新预约</view>
    </view>
    <switch checked="{{online}}" color="#0B6EF8" bindchange="onOnlineChange" />
  </view>

  <!-- 排班与在线状态矛盾：只配了时段但没开接诊，患者端仍会显示「暂不接诊」 -->
  <view wx:if="{{!loading && !error && !online && weekSlots > 0}}" class="ds-warn">
    <view class="ds-warn-body">
      <view class="ds-warn-title">排班已配置，但「在线接诊」未开启</view>
      <view class="ds-warn-sub">患者端会显示「暂不接诊」，无法选择您。开启后才能接收新的在线问诊。</view>
    </view>
    <view class="ds-warn-btn" bindtap="onEnableOnline" hover-class="ds-hover">开启</view>
  </view>

  <!-- 加载中 / 失败 -->
  <skeleton wx:if="{{loading}}" type="list" rows="5" />
  <view wx:elif="{{error}}" class="ds-state">
    <view class="ds-state-title">线上问诊设置加载失败</view>
    <view class="ds-state-sub">{{error}}</view>
    <view class="ds-btn ds-btn-primary" bindtap="fetch">重试</view>
  </view>

  <block wx:else>
    <!-- 周模板 -->
    <view class="ds-card">
      <view class="ds-card-head">每周接诊安排</view>
      <view class="ds-card-sub">患者需在下列时段内提交预约，您在工作台接单后即可对话</view>

      <!-- 汇总：本周时段数 + 预计可接诊人数 -->
      <view wx:if="{{weekSlots > 0}}" class="ds-sum">
        <view class="ds-sum-item">
          <text class="ds-sum-num">{{weekSlots}}</text>
          <text class="ds-sum-label">个接诊时段</text>
        </view>
        <view class="ds-sum-divider"></view>
        <view class="ds-sum-item">
          <text class="ds-sum-num">{{weekCapacity}}</text>
          <text class="ds-sum-label">人 / 周可接诊</text>
        </view>
      </view>

      <view wx:for="{{days}}" wx:key="weekday" wx:for-item="day" class="ds-day">
        <view class="ds-day-head">
          <text class="ds-day-name">{{day.name}}</text>
          <text class="ds-day-state {{day.hasSchedule ? 'ds-day-on' : ''}}">
            {{day.hasSchedule ? '接诊' : '休息'}}
          </text>
        </view>

        <block wx:if="{{day.hasSchedule}}">
          <view wx:for="{{day.slots}}" wx:key="index" wx:for-item="slot" wx:for-index="idx" class="ds-slot">
            <text class="ds-slot-time">{{slot.startTime}} - {{slot.endTime}}</text>
            <!-- 每时段可接诊人数（±1 调整，保存随模板提交） -->
            <view class="ds-cap">
              <view class="ds-cap-btn {{slot.capacity <= 1 ? 'ds-cap-btn-off' : ''}}"
                    data-weekday="{{day.weekday}}" data-index="{{idx}}" data-delta="-1"
                    bindtap="onCapStep">−</view>
              <text class="ds-cap-num">{{slot.capacity}}</text>
              <view class="ds-cap-btn {{slot.capacity >= 50 ? 'ds-cap-btn-off' : ''}}"
                    data-weekday="{{day.weekday}}" data-index="{{idx}}" data-delta="1"
                    bindtap="onCapStep">＋</view>
            </view>
            <view class="ds-slot-del" data-weekday="{{day.weekday}}" data-index="{{idx}}" bindtap="onRemoveSlot">删除</view>
          </view>
          <view class="ds-day-add" data-weekday="{{day.weekday}}" bindtap="onAddSlot">＋ 添加接诊时段</view>
        </block>
        <view wx:else class="ds-day-empty" data-weekday="{{day.weekday}}" bindtap="onAddSlot">
          点击添加接诊时段
        </view>
      </view>
    </view>

    <!-- 保存 -->
    <view class="ds-save">
      <view class="ds-btn ds-btn-primary ds-save-btn {{saving ? 'ds-btn-off' : ''}}" bindtap="onSave">保存线上问诊排班</view>
      <view class="ds-tip">关闭在线状态不影响已提交的预约；已接诊的会话请在「接诊工作台」处理完再下线。</view>
    </view>
  </block>

  <view class="ds-footbar-space"></view>
  <doctor-tabbar current="me" />
</view>
