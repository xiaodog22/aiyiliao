/* pages/doctor/schedule —— 线上问诊设置（医生端） */

.ds-page {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 60rpx;
}

.ds-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  background: #fff;
  border-bottom: 1rpx solid #eef0f3;
}
.ds-nav-bar {
  position: relative;
  height: 88rpx;
  display: flex;
  align-items: center;
}
.ds-nav-back {
  position: absolute;
  left: 8rpx;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ds-nav-back-ic { width: 44rpx; height: 44rpx; }
.ds-nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #17233d;
}
.ds-hover { opacity: 0.6; }

/* 在线开关 */
.ds-online {
  margin: 24rpx 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  display: flex;
  align-items: center;
}
.ds-online-body { flex: 1; }
.ds-online-title { font-size: 30rpx; font-weight: 600; color: #17233d; }
.ds-online-sub { font-size: 24rpx; color: #86909c; margin-top: 8rpx; }

/* 排班已配置但在线接诊未开启：显式提示，避免患者端一直“暂不接诊” */
.ds-warn {
  margin: 24rpx 24rpx 0;
  background: var(--amber-soft);
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.ds-warn-body { flex: 1; min-width: 0; }
.ds-warn-title { font-size: 28rpx; font-weight: 600; color: var(--amber-text); line-height: 1.5; }
.ds-warn-sub { font-size: 24rpx; color: var(--amber-text); line-height: 1.5; margin-top: 8rpx; }
.ds-warn-btn {
  flex-shrink: 0;
  min-width: 120rpx;
  min-height: 72rpx;
  border-radius: 36rpx;
  background: var(--amber-text);
  color: var(--card);
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 状态 */
.ds-state { padding: 120rpx 48rpx; display: flex; flex-direction: column; align-items: center; }
.ds-state-title { font-size: 32rpx; font-weight: 600; color: #17233d; margin-bottom: 12rpx; }
.ds-state-sub { font-size: 28rpx; color: #86909c; margin-bottom: 32rpx; }

/* 周模板 */
.ds-card {
  margin: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
}
.ds-card-head { font-size: 28rpx; font-weight: 600; color: #17233d; margin-bottom: 8rpx; }
.ds-card-sub { font-size: 24rpx; color: #86909c; line-height: 1.5; margin-bottom: 16rpx; }

/* 周汇总：X 个接诊时段 · Y 人 / 周可接诊 */
.ds-sum {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  margin-bottom: 8rpx;
  border-radius: 12rpx;
  background: #f3f7ff;
}
.ds-sum-item { flex: 1; display: flex; align-items: baseline; justify-content: center; }
.ds-sum-num { font-size: 40rpx; font-weight: 700; color: #0b6ef8; }
.ds-sum-label { margin-left: 8rpx; font-size: 22rpx; color: #86909c; }
.ds-sum-divider { width: 1rpx; height: 48rpx; background: #dbe4f3; }

.ds-day {
  border-top: 1rpx solid #f2f3f5;
  padding: 20rpx 0;
}
.ds-day-head { display: flex; align-items: center; margin-bottom: 12rpx; }
.ds-day-name { font-size: 30rpx; font-weight: 600; color: #17233d; flex: 1; }
.ds-day-state { font-size: 24rpx; color: #86909c; }
.ds-day-state.ds-day-on { color: #00b42a; }
.ds-slot {
  display: flex;
  align-items: center;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
}
.ds-slot-time { font-size: 28rpx; color: #17233d; flex: 1; }

/* 每时段可接诊人数：− N ＋ 步进 */
.ds-cap { display: flex; align-items: center; margin-right: 24rpx; }
.ds-cap-btn {
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  border: 1rpx solid #dbe4f3;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #0b6ef8;
  background: #fff;
}
.ds-cap-btn-off { color: #c9cdd4; border-color: #eef0f3; }
.ds-cap-num {
  min-width: 56rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #17233d;
}
.ds-slot-del { font-size: 26rpx; color: #f53f3f; }
.ds-day-add { font-size: 26rpx; color: #0b6ef8; text-align: center; padding: 12rpx 0; }
.ds-day-empty { font-size: 26rpx; color: #0b6ef8; text-align: center; padding: 12rpx 0; }

/* 保存 */
.ds-save { padding: 24rpx; }
.ds-btn {
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}
.ds-btn-primary { background: #0b6ef8; color: #fff; }
.ds-btn-off { opacity: 0.6; }
.ds-save-btn { margin-top: 8rpx; }
.ds-tip { margin-top: 16rpx; font-size: 22rpx; color: #86909c; line-height: 1.6; text-align: center; }

.ds-footbar-space { height: 140rpx; }
