/* pages/doctor/consult/consult —— 医生端在线问诊（医患图文会话）
   版式对齐患者端 pages/consult（04-在线问诊）：患者卡 + 日期分隔 + 左右气泡 + 底部输入栏。
   令牌全部取自 app.wxss（禁字面色值，仅 #FFFFFF）。 */

.dc-page {
  height: 100vh;
  /* ⚠️ 覆盖全局 .page 的 32rpx 内边距：聊天页要通栏贴底（顶部 navH 由内联 padding-top 给） */
  padding: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--bg);
}

/* ---------------- 自绘导航 ---------------- */
.dc-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 30;
  background: var(--card);
  border-bottom: 1rpx solid var(--border);
  box-sizing: border-box;
}
.dc-nav-bar {
  height: 44px;
  display: flex;
  align-items: center;
  padding: 0 12rpx;
}
.dc-back {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding-left: 12rpx;
  box-sizing: border-box;
}
.dc-back-ic { width: 44rpx; height: 44rpx; }
.dc-title {
  flex: 1;
  text-align: center;
  font-size: var(--font-h2);
  font-weight: 600;
  color: var(--text-main);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.dc-nav-ph { width: 88rpx; }

/* 导航右侧「结束」入口（会话模式）；88rpx 宽与左侧返回键等宽，标题保持居中。
   高度撑满 44px 导航条 → 触控热区达标，不必再用 ::after 补偿。 */
.dc-nav-end {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-right: 12rpx;
  box-sizing: border-box;
  font-size: calc(var(--font-caption) + 2rpx);
  font-weight: 600;
  color: var(--danger-text);
  white-space: nowrap;
}
/* 已结束后同一位置只留状态文字（不可点） */
.dc-nav-done {
  width: 88rpx;
  text-align: right;
  padding-right: 12rpx;
  box-sizing: border-box;
  /* 3 个字必须一行放得下：88rpx 槽位 - 右侧 12rpx 内边距 ≈ 38px → 字号压到 caption(12px)，
     否则会在导航右侧折成两行（2026-10-24 视觉复核发现） */
  font-size: var(--font-caption);
  color: var(--text-weak);
  white-space: nowrap;
}

/* ---------------- 列表模式 ---------------- */
.dc-body { flex: 1; min-height: 0; }
.dc-list-head { padding: 24rpx 32rpx 8rpx; }
.dc-list-tip { font-size: var(--font-caption); color: var(--text-sub); }
.dc-list { padding: 8rpx 24rpx calc(48rpx + env(safe-area-inset-bottom)); }

.dc-item {
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--border);
  box-shadow: var(--shadow-card);
}
.dc-item-head { display: flex; align-items: center; }
.dc-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--accent-soft);
  color: var(--primary);
  font-size: var(--font-h2);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.dc-item-main { flex: 1; min-width: 0; margin-left: 20rpx; }
.dc-item-row { display: flex; align-items: center; justify-content: space-between; }
.dc-patient {
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--text-main);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.dc-time {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: calc(var(--font-caption) - 2rpx);
  color: var(--text-weak);
}
.dc-summary {
  display: block;
  margin-top: 10rpx;
  font-size: calc(var(--font-body) - 4rpx);
  color: var(--text-sub);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.dc-item-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
}
.dc-count { font-size: calc(var(--font-caption) - 2rpx); color: var(--text-weak); }
.dc-item-state { display: flex; align-items: center; }
.dc-state-chip {
  margin-right: 16rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-sm);
  background: var(--bg);
  color: var(--text-sub);
  font-size: calc(var(--font-caption) - 4rpx);
  line-height: 1.6;
}
.dc-state-chip-on { background: var(--mint); color: var(--mint-text); }
.dc-go { font-size: calc(var(--font-body) - 2rpx); color: var(--primary); font-weight: 600; }
.dc-accept {
  font-size: calc(var(--font-body) - 2rpx);
  color: #FFFFFF;
  font-weight: 600;
  background: var(--primary);
  border-radius: var(--radius-sm);
  padding: 12rpx 32rpx;
}
.dc-loadmore { text-align: center; padding: 24rpx; color: var(--text-weak); font-size: var(--font-caption); }

/* ---------------- 空 / 错 ---------------- */
.dc-empty { padding: 100rpx 48rpx; text-align: center; }
.dc-empty-t { display: block; font-size: var(--font-body); color: var(--text-main); }
.dc-empty-s { display: block; margin-top: 12rpx; font-size: var(--font-caption); color: var(--text-sub); }
.dc-retry {
  display: inline-block;
  margin-top: 24rpx;
  padding: 14rpx 36rpx;
  border-radius: var(--radius-sm);
  background: var(--primary);
  color: #FFFFFF;
  font-size: var(--font-caption);
}

/* ---------------- 会话模式：患者信息卡 ---------------- */
.dc-card {
  margin: 20rpx 24rpx 0;
  padding: 24rpx 28rpx 0;
  border-radius: var(--radius-lg);
  background: var(--card);
  box-shadow: var(--shadow-card);
  flex-shrink: 0;
}
.dc-card-main { display: flex; align-items: center; min-height: 96rpx; }
.dc-card-face {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--accent-soft);
  color: var(--primary);
  font-size: var(--font-h2);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.dc-card-body { flex: 1; min-width: 0; margin-left: 20rpx; }
.dc-card-top { display: flex; align-items: center; }
.dc-card-name {
  font-size: var(--font-h2);
  font-weight: 600;
  color: var(--text-main);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.dc-card-chip {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-sm);
  background: var(--accent-soft);
  color: var(--primary);
  font-size: calc(var(--font-caption) - 4rpx);
  line-height: 1.6;
}
.dc-card-sub {
  margin-top: 8rpx;
  font-size: var(--font-caption);
  color: var(--text-sub);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.dc-card-state {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 8rpx 18rpx;
  border-radius: var(--radius-sm);
  background: var(--bg);
  color: var(--text-sub);
  font-size: calc(var(--font-caption) - 2rpx);
}
.dc-card-state-on { background: var(--mint); color: var(--mint-text); }
/* 已结束：灰底中性文字，与「正在接诊」的薄荷绿形成互斥观感 */
.dc-card-state-off { background: var(--border); color: var(--text-sub); }
.dc-card-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: currentColor;
  margin-right: 8rpx;
}
.dc-card-divider { height: 1rpx; background: var(--border); margin-top: 20rpx; }
.dc-card-tip {
  padding: 18rpx 0 20rpx;
  font-size: var(--font-caption);
  color: var(--text-weak);
}

/* ---------------- 会话模式：消息流 ---------------- */
.dc-chat { flex: 1; min-height: 0; padding: 16rpx 24rpx 0; box-sizing: border-box; }
.dc-anchor { height: calc(24rpx + env(safe-area-inset-bottom)); }

.dc-day { display: flex; align-items: center; justify-content: center; padding: 20rpx 0; }
.dc-day-line { width: 48rpx; height: 1rpx; background: var(--border); }
.dc-day-t {
  margin: 0 16rpx;
  font-size: calc(var(--font-caption) - 4rpx);
  color: var(--text-weak);
}
.dc-sys {
  margin: 8rpx auto 24rpx;
  max-width: 78%;
  padding: 10rpx 24rpx;
  border-radius: var(--radius-sm);
  background: var(--bg);
  color: var(--text-sub);
  font-size: calc(var(--font-caption) - 2rpx);
  text-align: center;
}

.dc-row { display: flex; align-items: flex-start; margin-bottom: 24rpx; }
.dc-row-left { justify-content: flex-start; }
.dc-row-right { justify-content: flex-end; }
.dc-face {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--accent-soft);
  color: var(--primary);
  font-size: var(--font-caption);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.dc-face-me { background: var(--primary); color: #FFFFFF; margin-left: 16rpx; }
.dc-row-left .dc-face { margin-right: 16rpx; }

.dc-bubble {
  max-width: 72%;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  box-sizing: border-box;
}
.dc-bubble-patient {
  background: var(--card);
  border: 1rpx solid var(--border);
  border-top-left-radius: 8rpx;
}
.dc-bubble-doctor {
  background: var(--primary);
  border-top-right-radius: 8rpx;
}
.dc-text {
  display: block;
  font-size: var(--font-body);
  line-height: 1.55;
  color: var(--text-main);
  word-break: break-word;
}
.dc-text-on { color: #FFFFFF; }
.dc-bubble-time {
  display: block;
  margin-top: 8rpx;
  font-size: calc(var(--font-caption) - 6rpx);
  color: var(--text-weak);
  text-align: right;
}
.dc-bubble-time-on { color: #FFFFFF; opacity: 0.75; }

/* ---------------- 输入栏 ---------------- */
.dc-reply-err {
  padding: 8rpx 32rpx;
  background: var(--card);
  font-size: calc(var(--font-caption) - 2rpx);
  color: var(--danger-text);
}
.dc-input-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--card);
  border-top: 1rpx solid var(--border);
}
.dc-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-md);
  background: var(--bg);
  font-size: var(--font-body);
  color: var(--text-main);
}
.dc-input-ph { color: var(--text-weak); }
.dc-send {
  flex-shrink: 0;
  margin-left: 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 36rpx;
  border-radius: var(--radius-md);
  background: var(--border);
  color: var(--text-weak);
  font-size: var(--font-body);
  font-weight: 600;
  text-align: center;
}
.dc-send-on { background: var(--primary); color: #FFFFFF; }

/* 已结束：底部输入栏替换为只读提示（不再渲染 input，避免误以为还能发） */
.dc-closed {
  flex-shrink: 0;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: var(--card);
  border-top: 1rpx solid var(--border);
  text-align: center;
}
.dc-closed-t {
  font-size: var(--font-caption);
  color: var(--text-weak);
}

/* ---------------- 宽屏（≥600px）：rpx 一律折 px（÷2），主栏 375px 居中 ---------------- */
@media (min-width: 600px) {
  .dc-page { padding-left: 0; }
  .dc-body, .dc-card, .dc-chat, .dc-input-bar, .dc-reply-err, .dc-closed, .dc-list-head, .dc-list {
    width: 100%;
    max-width: 375px;
    margin-left: auto;
    margin-right: auto;
    box-sizing: border-box;
  }
  .dc-nav-bar { height: 44px; }
  .dc-back { width: 44px; height: 44px; padding-left: 6px; }
  .dc-back-ic { width: 22px; height: 22px; }
  .dc-title { font-size: 17px; }
  .dc-nav-ph { width: 44px; }
  .dc-nav-end { width: 44px; height: 44px; padding-right: 6px; font-size: 14px; }
  .dc-nav-done { width: 44px; padding-right: 6px; font-size: 12px; }

  .dc-list-head { padding: 12px 16px 4px; }
  .dc-list-tip { font-size: 12px; }
  .dc-list { padding: 4px 12px 24px; }
  .dc-item { padding: 12px; margin-bottom: 10px; border-radius: 16px; border-width: 1px; }
  .dc-item-main { margin-left: 10px; }
  .dc-avatar { width: 44px; height: 44px; font-size: 17px; }
  .dc-summary { margin-top: 5px; font-size: 13px; }
  .dc-item-meta { margin-top: 9px; padding-top: 8px; border-top-width: 1px; }
  .dc-accept { padding: 6px 16px; font-size: 14px; }
  .dc-go { font-size: 14px; }
  .dc-state-chip { margin-right: 8px; padding: 2px 7px; }

  .dc-empty { padding: 50px 24px; }
  .dc-retry { margin-top: 12px; padding: 7px 18px; }

  .dc-card { margin: 10px 12px 0; padding: 12px 14px 0; border-radius: 16px; }
  .dc-card-main { min-height: 48px; }
  .dc-card-face { width: 48px; height: 48px; font-size: 17px; }
  .dc-card-body { margin-left: 10px; }
  .dc-card-chip { margin-left: 6px; padding: 2px 7px; }
  .dc-card-sub { margin-top: 4px; }
  .dc-card-state { padding: 4px 9px; }
  .dc-card-divider { margin-top: 10px; height: 1px; }
  .dc-card-tip { padding: 9px 0 10px; }

  .dc-chat { padding: 8px 12px 0; }
  .dc-anchor { height: 12px; }
  .dc-day { padding: 10px 0; }
  .dc-day-line { width: 24px; height: 1px; }
  .dc-day-t { margin: 0 8px; }
  .dc-sys { margin: 4px auto 12px; padding: 5px 12px; max-width: 78%; }
  .dc-row { margin-bottom: 12px; }
  .dc-face { width: 36px; height: 36px; font-size: 12px; }
  .dc-face-me { margin-left: 8px; }
  .dc-row-left .dc-face { margin-right: 8px; }
  .dc-bubble { padding: 10px 12px; border-radius: 10px; }
  .dc-bubble-patient { border-width: 1px; border-top-left-radius: 4px; }
  .dc-bubble-doctor { border-top-right-radius: 4px; }
  .dc-text { font-size: 15px; }
  .dc-bubble-time { margin-top: 4px; font-size: 10px; }

  .dc-reply-err { padding: 4px 16px; }
  .dc-input-bar { padding: 8px 12px 8px; border-top-width: 1px; }
  .dc-input { height: 44px; line-height: 44px; padding: 0 12px; border-radius: 12px; font-size: 15px; }
  .dc-send { margin-left: 8px; height: 44px; line-height: 44px; padding: 0 18px; border-radius: 12px; font-size: 15px; }
  .dc-closed { padding: 12px 16px 12px; border-top-width: 1px; }
  .dc-closed-t { font-size: 12px; }
}
