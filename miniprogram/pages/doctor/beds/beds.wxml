<!--
  pages/doctor/beds —— 床位管理（医生端·申请制）
  版式：design-output/医生端/E-医生端/14-床位管理.png（1391×3014，1rpx ≈ 1.8547px，逐元素实测）

  ① 自定义导航栏（返回 + 居中标题；右侧胶囊由微信自绘）
  ② 床位统计（总床位 / 占用 / 空闲 / 待消毒）—— 增强项，设计稿无，口径见 README §8.40
  ③ 我的床位申请（申请制新增）：待审批(橙) / 已通过(绿) / 已驳回(红) / 已撤销(灰)
  ④ 病区横滑筛选 —— 增强项，**仅当医生有 ≥2 个授权病区时出现**（单病区时与设计稿一致）
  ⑤ 图例：空闲(绿) / 占用(蓝) / 维修中(灰)；床位数据里出现「待消毒」「已预留」时才追加对应图例
  ⑥ 床位卡（2 列）：空闲=白底绿描边 + 申请床位；占用=蓝色渐变头 + 浅蓝底 + 患者脱敏名；
     待消毒=浅橙底；维修中=中性灰；已预留=浅蓝渐变

  ⚠️ 申请制：医生端不直接改床位状态，空闲床位只能提交申请 → 护士站审批（后端落床）。
  ⚠️ 状态只认契约英文枚举（BedStatus / 申请状态），中文与配色由 JS 唯一映射，模板不写英文判断。
  ⚠️ 不伪造：wardName / patientDisplayName 缺失就不渲染对应文案。
-->
<view class="page theme-{{theme}} bd-page" style="padding-top: {{navH}}px;">

  <!-- ① 自定义导航栏（fixed，页面用 padding-top 让位） -->
  <view class="bd-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="bd-nav-bar">
      <view class="bd-nav-back" bindtap="onBack" hover-class="bd-hover"
            aria-role="button" aria-label="返回">
        <image class="bd-nav-back-ic" src="{{icons.chevronLeft}}" />
      </view>
      <view class="bd-nav-title">床位管理</view>
    </view>
  </view>

  <offline-bar />

  <!-- ② 床位统计（加载中显灰块，失败显弱化灰块；不显 0 冒充真实值） -->
  <view class="bd-stats">
    <view wx:for="{{stats}}" wx:key="key" class="bds-col">
      <view class="bds-label">{{item.label}}</view>
      <view wx:if="{{loading}}" class="bds-skel"></view>
      <view wx:elif="{{error}}" class="bds-skel bds-skel-mute"></view>
      <view wx:else class="bds-v">{{item.value}}</view>
    </view>
  </view>

  <!-- ③ 我的床位申请（申请制）：护士站审批结果在这里回看 -->
  <view class="apps-card">
    <view class="apps-head">
      <view class="apps-title">我的床位申请</view>
      <view wx:if="{{appsLoading}}" class="apps-hint">加载中…</view>
      <view wx:elif="{{appsError}}" class="apps-hint apps-hint-err" bindtap="fetchApplications">{{appsError}}，点此重试</view>
      <view wx:else class="apps-hint">共 {{apps.length}} 条</view>
    </view>

    <view wx:if="{{!appsLoading && !appsError && apps.length === 0}}" class="apps-empty">
      暂无申请。点下方空闲床位的「申请床位」发起
    </view>

    <view wx:else>
      <view wx:for="{{apps}}" wx:key="id" class="app-row">
        <view class="app-line1">
          <view class="app-target">{{item.target}}</view>
          <view wx:if="{{item.urgent}}" class="app-urgent">紧急</view>
          <view class="app-state app-state-{{item.cls}}">{{item.statusText}}</view>
        </view>
        <view wx:if="{{item.patient}}" class="app-patient">患者：{{item.patient}}</view>
        <view wx:if="{{item.reason}}" class="app-reason">{{item.reason}}</view>
        <view wx:if="{{item.reviewNote}}" class="app-note">审批意见：{{item.reviewNote}}</view>
        <view wx:if="{{item.time}}" class="app-time">{{item.time}} 提交</view>
      </view>
    </view>
  </view>

  <!-- ④ 病区筛选：单病区不渲染（保持设计稿版式） -->
  <scroll-view wx:if="{{wards.length > 1}}" class="bd-wards" scroll-x>
    <view class="bd-ward {{wardId === '' ? 'bd-ward-on' : ''}}"
          data-id="" bindtap="onWardTap" aria-role="button">全部病区</view>
    <view wx:for="{{wards}}" wx:key="id"
          class="bd-ward {{wardId === item.id ? 'bd-ward-on' : ''}}"
          data-id="{{item.id}}" bindtap="onWardTap" aria-role="button">{{item.name}}</view>
  </scroll-view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="state">
    <view class="state-badge state-badge-gray"><image class="state-ic" src="{{icons.refreshGray}}" /></view>
    <view class="state-title">正在加载床位…</view>
  </view>

  <!-- 加载失败：图标 + 中文说明 + 实心重试按钮 -->
  <view wx:elif="{{error}}" class="state">
    <view class="state-badge state-badge-primary"><image class="state-ic" src="{{icons.alertWhite}}" /></view>
    <view class="state-title">床位信息加载失败</view>
    <view class="state-sub">{{error}}</view>
    <view class="btn btn-primary state-btn" bindtap="fetch">重试</view>
  </view>

  <block wx:elif="{{displayed.length > 0}}">
    <!-- ⑤ 图例 -->
    <view class="bd-legend">
      <view wx:for="{{legend}}" wx:key="cls" class="bl-item">
        <view class="bl-dot bl-dot-{{item.cls}}"></view>
        <text class="bl-text bl-text-{{item.cls}}">{{item.text}}</text>
      </view>
    </view>

    <!-- ⑥ 床位卡（2 列） -->
    <view class="bed-grid">
      <view wx:for="{{displayed}}" wx:key="id" class="bed-card bed-{{item.cls}}">
        <view class="bed-top">
          <view class="bed-no">{{item.no}}</view>
          <view class="bed-status">{{item.statusText}}</view>
        </view>

        <!-- 患者脱敏展示名（仅占用/已预留且后端下发时渲染） -->
        <view wx:if="{{item.patient}}" class="bed-patient">{{item.patient}}</view>

        <!-- 仅空闲床位可「申请床位」（申请制：提交后待护士站审批，不直接落床） -->
        <view wx:if="{{item.canApply}}" class="bed-apply"
              data-id="{{item.id}}" data-no="{{item.no}}" data-ward="{{item.wardId}}"
              data-wardname="{{item.wardName}}"
              bindtap="onApplyTap" hover-class="bed-apply-hover"
              aria-role="button" aria-label="{{item.no}} 申请床位">申请床位</view>
      </view>
    </view>

    <view wx:if="{{hasMore}}" class="load-more">上拉加载更多</view>
    <view wx:else class="load-all">已显示全部 {{displayed.length}} 张床位</view>
  </block>

  <view wx:else class="state">
    <view class="state-badge state-badge-gray"><image class="state-ic" src="{{icons.searchGray}}" /></view>
    <view class="state-title">{{wardId ? '该病区暂无床位' : '暂无床位数据'}}</view>
    <view class="state-sub">床位信息接入后会显示在这里</view>
  </view>

  <!-- 申请抽屉（AVAILABLE 床位）：默认从“近期接诊患者”选择，提交 appointmentId；
       手动内部患者编号只作兜底。审批通过且床位空闲时由后端落床，医生端不做直接状态写入。 -->
  <view wx:if="{{showApply}}" class="sheet-mask" bindtap="closeApply">
    <view class="sheet apply-sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-title">申请床位 · {{applyBedNo}}</view>
      <view class="apply-subtitle">{{applyWardName || '当前病区'}} · 提交后由护士站审批</view>

      <view class="apply-step">
        <view class="step-badge">1</view>
        <view class="step-copy">
          <view class="step-title">选择患者</view>
          <view class="step-sub">从近期接诊患者中选择，不用输入内部编号</view>
        </view>
      </view>

      <block wx:if="{{!applyManual && !applySelected}}">
        <input class="cand-search" placeholder="搜索姓名 / 手机号 / 排队号"
               value="{{applySearch}}" bindinput="onCandidateSearch" confirm-type="search" />

        <view wx:if="{{applyCandidatesLoading}}" class="cand-state">正在加载近期患者…</view>
        <view wx:elif="{{applyCandidatesError}}" class="cand-state cand-err">{{applyCandidatesError}}</view>
        <scroll-view wx:elif="{{applyCandidatesView.length}}" class="cand-scroll" scroll-y>
          <view wx:for="{{applyCandidatesView}}" wx:key="id"
                class="cand-card"
                data-id="{{item.id}}" data-name="{{item.name}}"
                bindtap="onCandidateTap" hover-class="cand-hover"
                aria-role="button" aria-label="选择患者 {{item.name}}">
            <view class="cand-avatar">{{item.initial}}</view>
            <view class="cand-main">
              <view class="cand-name-row">
                <text class="cand-name">{{item.name}}</text>
                <text wx:if="{{item.queueText}}" class="cand-queue">{{item.queueText}}</text>
              </view>
              <view class="cand-meta">{{item.metaText}}</view>
              <view wx:if="{{item.symptom}}" class="cand-symptom">主诉：{{item.symptom}}</view>
              <view class="cand-status">{{item.statusText}}</view>
            </view>
            <view class="cand-pick">选择</view>
          </view>
        </scroll-view>
        <view wx:else class="cand-state">暂无近期接诊患者，请改用手动输入</view>
      </block>

      <view wx:if="{{applyManual}}" class="form-row">
        <view class="form-label">患者内部编号（兜底）</view>
        <input class="form-input" placeholder="仅用于患者列表找不到时"
               value="{{applyPatientRef}}" data-field="applyPatientRef" bindinput="onApplyInput" />
        <view class="form-hint">编号由院内系统分配，不是手机号或姓名。</view>
      </view>

      <view wx:if="{{!applySelected}}" class="manual-toggle" bindtap="toggleManual" aria-role="button">
        {{applyManual ? '返回患者列表选择' : '找不到患者？手动输入内部编号'}}
      </view>

      <view wx:if="{{applySelected}}" class="pick-summary">
        <text class="pick-text">{{applySelectedLabel}}</text>
        <text wx:if="{{!applyManual}}" class="pick-change" bindtap="onReselect" aria-role="button">重新选择</text>
        <text wx:else class="pick-change" bindtap="toggleManual" aria-role="button">返回患者列表</text>
      </view>

      <block wx:if="{{applySelected}}">
        <view class="apply-step apply-step-gap">
          <view class="step-badge">2</view>
          <view class="step-copy">
            <view class="step-title">确认申请信息</view>
            <view class="step-sub">病情说明会随申请单一起给到护士站</view>
          </view>
        </view>

        <view class="bed-summary">
          <view class="bed-summary-no">{{applyBedNo}}</view>
          <view class="bed-summary-sub">{{applyWardName || '当前病区'}} · 申请通过后落床</view>
        </view>

        <view class="form-row">
          <view class="form-label">快捷原因（选填）</view>
          <view class="reason-row">
            <view wx:for="{{applyReasonChips}}" wx:key="*this"
                  class="reason-chip {{applyReasonChip === item ? 'reason-chip-on' : ''}}"
                  data-label="{{item}}" bindtap="onReasonChipTap" aria-role="button">{{item}}</view>
          </view>
        </view>

        <view class="form-row">
          <view class="form-label">补充说明（选填）</view>
          <textarea class="form-area" placeholder="可补充症状、护理需求或申请说明（≤200 字）"
                    maxlength="200" value="{{applyReason}}" data-field="applyReason"
                    bindinput="onApplyInput" auto-height />
        </view>

        <view class="form-row">
          <view class="form-label">优先级</view>
          <view class="pri-row">
            <view class="pri-chip {{applyPriority === 'NORMAL' ? 'pri-chip-on' : ''}}"
                  data-p="NORMAL" bindtap="onPriorityTap" aria-role="button">普通</view>
            <view class="pri-chip {{applyPriority === 'URGENT' ? 'pri-chip-on' : ''}}"
                  data-p="URGENT" bindtap="onPriorityTap" aria-role="button">加急</view>
          </view>
          <view class="form-hint">加急只表示请护士优先处理，不代表病情分级。</view>
        </view>

        <view class="apply-foot-note">提交后进入待审批；护士站通过且床位仍空闲时才会落床。</view>
      </block>

      <view wx:if="{{applyErr}}" class="form-err">{{applyErr}}</view>
      <view wx:if="{{!applySelected}}" class="apply-wait">选择患者后，继续填写申请信息</view>

      <view class="sheet-actions">
        <view class="btn btn-ghost" bindtap="closeApply">取消</view>
        <view class="btn btn-primary {{applySelected ? '' : 'btn-disabled'}} {{applying ? 'btn-loading' : ''}}"
              bindtap="confirmApply">
          {{applying ? '提交中…' : '提交申请'}}
        </view>
      </view>
    </view>
  </view>

</view>
