<!-- 家庭成员管理（设计稿 患者端/C-个人中心/08-家庭成员.png）
     版式：顶部通栏浅蓝渐变带 + 半透明提示面板 → 成员白卡（头像 / 姓名 / 关系徽章 / 年龄·授权）
           → 卡内**通栏**分隔线 + 左右裸文字操作 → 贴底「添加家庭成员」描边胶囊 + 授权说明
     ⚠️ 与设计稿的差异（详见 DEV_LOG）：设计稿操作行只有「管理健康档案 / 移除成员」，无「编辑」；
        卡片副行按设计稿展示「年龄段 · 授权态」，不是手机号。
     数据：GET /api/v1/family-members · 添加 POST · 移除 DELETE（全走 services/user.js） -->
<view class="page fm-page theme-{{theme}}">

  <!-- 顶部提示：通栏浅蓝渐变带（实测 #E1F1FF → 页底，高约 407px=220rpx） -->
  <view class="fm-hero">
    <view class="fm-tip">
      <image class="fm-tip-ic" src="{{icons.users}}" mode="aspectFit" />
      <view class="fm-tip-text">可为家人管理健康档案与预约挂号，让家人的就医安排更省心。</view>
    </view>
  </view>

  <view class="fm-body">
    <!-- 骨架屏：加载中 -->
    <skeleton wx:if="{{loading}}" type="list" rows="2" />

    <!-- 上线阶段错误态（开发阶段 withFallback 兜底演示数据，不会走到这里） -->
    <view wx:elif="{{error}}" class="state">
      <view class="state-badge state-badge-primary"><image class="state-ic" src="{{icons.alertWhite}}" /></view>
      <view class="state-title">成员列表加载失败</view>
      <view class="state-sub">{{error}}</view>
      <view class="btn btn-primary state-btn" bindtap="fetch">重新加载</view>
    </view>

    <block wx:elif="{{members.length > 0}}">
      <view wx:for="{{members}}" wx:key="id" class="fm-card">
        <view class="fm-head">
          <!-- 头像：契约 avatarUrl（短期签名 URL）优先；无头像/加载失败 → CSS 人形占位（不伪造真人头像） -->
          <view class="fm-avatar">
            <image wx:if="{{item.avatarUrl && !item.avatarErr}}"
                   class="fm-avatar-img" src="{{item.avatarUrl}}" mode="aspectFill"
                   data-index="{{index}}" binderror="onAvatarErr" />
            <view wx:else class="fm-ava-ph">
              <view class="fm-ava-head"></view>
              <view class="fm-ava-body"></view>
            </view>
          </view>
          <view class="fm-info">
            <view class="fm-name">{{item.name}}</view>
            <view wx:if="{{item.metaText}}" class="fm-meta">{{item.metaText}}</view>
          </view>
          <view wx:if="{{item.relation}}" class="fm-chip">{{item.relation}}</view>
        </view>
        <view class="fm-actions">
          <view class="fm-act" data-index="{{index}}" bindtap="onManage">管理健康档案</view>
          <view wx:if="{{item.relation !== '本人'}}" class="fm-act fm-act-danger"
                data-index="{{index}}" bindtap="onRemove">移除成员</view>
        </view>
      </view>
    </block>

    <!-- 空态：后端返回空列表 -->
    <view wx:else class="state">
      <view class="state-badge state-badge-gray"><image class="state-ic" src="{{icons.usersGray}}" /></view>
      <view class="state-title">暂无家庭成员</view>
      <view class="state-sub">添加家人信息后，可在这里统一管理</view>
    </view>
  </view>

  <!-- 贴底操作（设计稿：内容不足一屏时按钮靠底，用 margin-top:auto 实现，不做 fixed 以免遮挡列表） -->
  <view class="fm-footer">
    <view class="fm-add" bindtap="onAdd">
      <image class="fm-add-ic" src="{{icons.plus}}" mode="aspectFit" />
      <text class="fm-add-t">添加家庭成员</text>
    </view>
    <view class="fm-note">添加成员需获得对方授权后方可管理其健康档案</view>
  </view>

</view>

<!-- 添加成员表单：半屏浮层（设计稿无此弹窗，本端按契约字段自绘；不采集契约外字段） -->
<view wx:if="{{sheetOpen}}" class="fm-mask" bindtap="onSheetClose" catchtouchmove="noop">
  <view class="fm-sheet" catchtap="noop">
    <view class="fm-sheet-head">
      <text class="fm-sheet-title">添加家庭成员</text>
      <text class="fm-sheet-cancel" bindtap="onSheetClose">取消</text>
    </view>

    <view class="fm-field">
      <text class="fm-label">姓名</text>
      <input class="fm-input" value="{{form.name}}" placeholder="请输入成员姓名"
             placeholder-class="fm-ph" maxlength="20" bindinput="onInputName" />
    </view>

    <view class="fm-field">
      <text class="fm-label">与本人关系</text>
      <view class="fm-relations">
        <view wx:for="{{relations}}" wx:key="*this"
              class="fm-rchip {{form.relation === item ? 'fm-rchip-on' : ''}}"
              data-rel="{{item}}" bindtap="onPickRelation">{{item}}</view>
      </view>
    </view>

    <view class="fm-field fm-field-last">
      <text class="fm-label">手机号<text class="fm-optional">（选填）</text></text>
      <input class="fm-input" type="number" value="{{form.phone}}" placeholder="用于后续授权核验"
             placeholder-class="fm-ph" maxlength="11" bindinput="onInputPhone" />
    </view>

    <view wx:if="{{formErr}}" class="fm-err">{{formErr}}</view>
    <view class="fm-privacy">身份证号不在本页采集：成员身份在对方授权时核验（最小必要原则）。</view>

    <button class="fm-submit {{saving ? 'fm-submit-busy' : ''}}" loading="{{saving}}" bindtap="onSubmit">确认添加</button>
  </view>
</view>
