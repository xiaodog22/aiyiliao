/* pages/profile/privacy —— 隐私政策（真实页面） */
.legal-page {
  padding: var(--space-page);
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--bg);
}

.legal-head {
  padding: 16rpx 0 28rpx;
  border-bottom: 1rpx solid var(--border);
  margin-bottom: 24rpx;
}

.legal-body {
  margin-top: 8rpx;
}

.legal-title {
  font-size: var(--font-title);
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.3;
}

.legal-sub {
  margin-top: 8rpx;
  font-size: calc(var(--font-caption) + 2rpx);
  color: var(--text-sub);
}

.legal-sec { margin-bottom: 28rpx; }

.legal-h {
  font-size: var(--font-body);
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 10rpx;
  line-height: 1.4;
}

.legal-p {
  font-size: calc(var(--font-caption) + 2rpx);
  color: var(--text-sub);
  line-height: 1.7;
}

.legal-note {
  margin-top: 36rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-md);
  background: var(--amber-soft);
  color: var(--amber-text);
  font-size: calc(var(--font-caption) - 2rpx);
  line-height: 1.6;
}

/* 宽屏：回到 px 口径 */
@media (min-width: 600px) {
  .legal-head { padding: 8px 0 14px; margin-bottom: 12px; }
  .legal-sub { margin-top: 4px; }
  .legal-sec { margin-bottom: 14px; }
  .legal-h { margin-bottom: 5px; }
  .legal-note { margin-top: 18px; padding: 10px 12px; }
}
