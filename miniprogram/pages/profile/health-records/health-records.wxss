/* pages/profile/health-records —— 健康档案（设计稿 05，1391×3014，1rpx ≈ 1.8547px）
   版式：个人信息卡 → 分类宫格 → 报告/记录卡流 → 加密说明条。
   实测卡片左右边距 41px=22rpx、卡片间距 34px=18rpx、个人信息卡高 269px=145rpx、
   宫格卡 555px=299rpx、报告卡 480~515px=259~278rpx、说明条 197px=106rpx。
   ⚠️ 尺寸一律 rpx；600px 断点内全部折 px（÷2，含 calc(…rpx) 与 border-width）。 */

/* 页面边距 24rpx（实测 22rpx，比全局 --space-page 32rpx 窄 —— 这页是卡片流，信息密度高） */
.hrc-page {
  padding: 24rpx;
}

/* ================= ① 个人信息卡 ================= */
.hrc-patient {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-radius: var(--radius-lg);
  /* 渐变走「白底 + primary 的 rgba 叠加」：不引入新色值 */
  background:
    linear-gradient(135deg, rgba(11, 110, 248, 0.11) 0%, rgba(11, 110, 248, 0.02) 100%),
    var(--card);
  box-shadow: var(--shadow-card);
}

.hrc-av {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  border-radius: 50%;
  overflow: hidden;
  background: var(--accent-soft);
}

.hrc-av-img {
  width: 100%;
  height: 100%;
  display: block;
}

.hrc-patient-body {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.hrc-patient-top {
  display: flex;
  align-items: center;
}

/* 实测姓名字形高 59px=32rpx → --font-h2(34rpx) 最接近且随适老化缩放 */
.hrc-name {
  font-size: var(--font-h2);
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.3;
  max-width: 340rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 「本人」标记：设计稿是浅蓝底小胶囊，字号比姓名低一档 */
.hrc-self {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-sm);
  background: var(--accent-soft);
  color: var(--primary);
  font-size: calc(var(--font-caption) - 2rpx);
  font-weight: 600;
  line-height: 1.6;
}

/* 实测副标题字形高 37px=20rpx；令牌最小档是 --font-caption(24rpx)，取它并收行高 */
.hrc-patient-sub {
  margin-top: 10rpx;
  font-size: var(--font-caption);
  color: var(--text-weak);
  line-height: 1.4;
}

.hrc-arrow {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
  opacity: 0.45;
}

/* ================= ② 分类宫格 ================= */
/* 设计稿：白卡内 3 列，图标底板 + 两字标签；换行后左对齐（不居中留空） */
.hrc-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28rpx 0;
  margin-top: 18rpx;
  padding: 32rpx 16rpx;
  border-radius: var(--radius-lg);
  background: var(--card);
  box-shadow: var(--shadow-card);
}

.hrc-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.hrc-tile {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-md);
  background: var(--accent-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.hrc-cell-ic {
  width: 48rpx;
  height: 48rpx;
}

.hrc-cell-t {
  margin-top: 12rpx;
  font-size: var(--font-caption);
  color: var(--text-main);
  line-height: 1.4;
  text-align: center;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 选中态：底板描主色边 + 文字转主色（设计稿无选中态，但宫格是可筛选入口，必须有可辨反馈） */
.hrc-cell-on .hrc-tile {
  border-color: var(--primary);
  background: var(--card);
}

.hrc-cell-on .hrc-cell-t {
  color: var(--primary);
  font-weight: 600;
}

/* ================= ③ 报告 / 记录卡 ================= */
.hrc-rec {
  margin-top: 18rpx;
  padding: 32rpx;
  border-radius: var(--radius-lg);
  background: var(--card);
  box-shadow: var(--shadow-card);
}

.hrc-rec-top {
  display: flex;
  align-items: flex-start;
}

/* 标题：设计稿约 32rpx/700，两行截断（长报告名不撑破卡片） */
.hrc-rec-title {
  flex: 1;
  min-width: 0;
  font-size: calc(var(--font-body) + 2rpx);
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 状态徽章：圆点 + 文字（设计稿「已出结果」绿点 /「待审核」橙点）。
   ⚠️ 颜色走语义令牌：READY 用 mint（成功），其余用 amber（待处理）。 */
.hrc-state {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  margin-left: 16rpx;
  padding-top: 4rpx;
}

.hrc-state-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  background: var(--text-weak);
}

.hrc-state-t {
  font-size: var(--font-caption);
  line-height: 1.4;
  white-space: nowrap;
}

.hrc-state.badge-mint .hrc-state-dot { background: var(--mint); }
.hrc-state.badge-mint .hrc-state-t { color: var(--mint-text); }
.hrc-state.badge-amber .hrc-state-dot { background: var(--accent-amber); }
.hrc-state.badge-amber .hrc-state-t { color: var(--amber-text); }

/* 副信息：类别 · 日期（设计稿是「本院区 · 门诊检验 / 2026-10-15 上午」两行，契约无机构字段） */
.hrc-rec-meta {
  margin-top: 12rpx;
  font-size: var(--font-caption);
  color: var(--text-weak);
  line-height: 1.5;
}

/* 摘要：诊断摘要 / 医嘱，可选字段 */
.hrc-rec-sum {
  margin-top: 12rpx;
  font-size: var(--font-caption);
  color: var(--text-sub);
  line-height: 1.6;
}

/* ================= 附件缩略（V9） ================= */
.hrc-att {
  margin-top: 20rpx;
  white-space: nowrap;
}

.hrc-att-item {
  position: relative;
  display: inline-block;
  width: 168rpx;
  margin-right: 16rpx;
  vertical-align: top;
}

.hrc-att-img,
.hrc-att-pdf {
  width: 168rpx;
  height: 126rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
  display: block;
}

.hrc-att-pdf {
  background: var(--accent-soft);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.hrc-att-pdf-ic {
  width: 40rpx;
  height: 40rpx;
}

.hrc-att-pdf-t {
  margin-top: 4rpx;
  font-size: calc(var(--font-caption) - 4rpx);
  color: var(--primary);
  line-height: 1.3;
}

/* 删除角标：右上角，热区 40rpx（视觉圆 32rpx） */
.hrc-att-del {
  position: absolute;
  right: -8rpx;
  top: -8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--accent-red);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hrc-att-del-ic {
  width: 22rpx;
  height: 22rpx;
}

/* ================= 操作行（设计稿两枚等宽胶囊） ================= */
.hrc-actions {
  display: flex;
  margin-top: 24rpx;
}

/* ⚠️ 设计稿按钮实高约 43rpx，远低于 88rpx 触控线 → 折中 72rpx（36px，仍可稳点） */
.hrc-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: var(--font-caption);
  font-weight: 600;
  box-sizing: border-box;
}

.hrc-btn + .hrc-btn {
  margin-left: 20rpx;
}

/* 查看报告：白底 + 主色描边 */
.hrc-btn-outline {
  border: 2rpx solid var(--primary);
  color: var(--primary);
  background: var(--card);
}

/* AI 解读：浅蓝实底 */
.hrc-btn-soft {
  background: var(--accent-soft);
  color: var(--primary);
}

/* 解读中：降透明度 + 禁点（逻辑侧另有 interpreting 连点保护） */
.hrc-btn-busy {
  opacity: 0.55;
}

/* 报告未就绪（待出具/待审核）：两枚按钮同时置灰（设计稿 05 胸部X光片的状态）。
   ⚠️ 只改视觉，点击仍落到 handler —— 由 handler 给"尚未出具"的中文提示，
      避免"点了没反应"的死按钮。 */
.hrc-btn-locked {
  border: 2rpx solid var(--border);
  color: var(--text-placeholder);
  background: var(--card);
}

.hrc-btn-locked-soft {
  background: var(--bg);        /* 用页底色当禁用底，不引入 #F2F3F5 这类字面色值 */
  color: var(--text-placeholder);
}

/* 上传检查资料（设计稿未画，弱化为文字链接） */
.hrc-add {
  margin-top: 20rpx;
  text-align: center;
  font-size: var(--font-caption);
  color: var(--text-weak);
  line-height: 1.6;
}

.hrc-add-busy {
  opacity: 0.5;
}

/* ================= AI 解读结果 / 失败提示 ================= */
.hrc-ai-fail {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-sm);
  background: var(--amber-soft);
  font-size: var(--font-caption);
  color: var(--amber-text);
  line-height: 1.6;
}

.hrc-ai-box {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: var(--radius-md);
  background: var(--accent-soft);
}

.hrc-ai-sum {
  font-size: var(--font-caption);
  color: var(--text-main);
  font-weight: 600;
  line-height: 1.6;
}

.hrc-ai-sec {
  margin-top: 16rpx;
}

.hrc-ai-sec-t {
  font-size: var(--font-caption);
  color: var(--primary-dark);
  font-weight: 600;
  line-height: 1.6;
}

.hrc-ai-sec-b {
  margin-top: 4rpx;
  font-size: var(--font-caption);
  color: var(--text-sub);
  line-height: 1.65;
}

.hrc-ai-dis {
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--border);
  font-size: calc(var(--font-caption) - 2rpx);
  color: var(--text-weak);
  line-height: 1.6;
}

/* ================= ④ 加密说明条 ================= */
.hrc-secure {
  margin-top: 18rpx;
}

/* ================= 平板断点（≥600px）：rpx → px（÷2）+ 主栏 375px 居中 ================= */
@media (min-width: 600px) {
  .hrc-page {
    max-width: 375px;
    margin: 0 auto;
    padding: 12px;
  }

  .hrc-patient { padding: 16px; }
  .hrc-av { width: 48px; height: 48px; }
  .hrc-patient-body { margin-left: 12px; }
  .hrc-name { max-width: 170px; }
  .hrc-self { margin-left: 6px; padding: 1px 6px; }
  .hrc-patient-sub { margin-top: 5px; }
  .hrc-arrow { width: 16px; height: 16px; margin-left: 6px; }

  .hrc-grid {
    gap: 14px 0;
    margin-top: 9px;
    padding: 16px 8px;
  }
  .hrc-tile { width: 44px; height: 44px; border-width: 1px; }
  .hrc-cell-ic { width: 24px; height: 24px; }
  .hrc-cell-t { margin-top: 6px; }

  .hrc-rec { margin-top: 9px; padding: 16px; }

  .hrc-state { margin-left: 8px; padding-top: 2px; }
  .hrc-state-dot { width: 6px; height: 6px; margin-right: 4px; }

  .hrc-rec-meta { margin-top: 6px; }
  .hrc-rec-sum { margin-top: 6px; }

  .hrc-att { margin-top: 10px; }
  .hrc-att-item { width: 84px; margin-right: 8px; }
  .hrc-att-img, .hrc-att-pdf { width: 84px; height: 63px; }
  .hrc-att-pdf-ic { width: 20px; height: 20px; }
  .hrc-att-pdf-t { margin-top: 2px; }
  .hrc-att-del { right: -4px; top: -4px; width: 20px; height: 20px; }
  .hrc-att-del-ic { width: 11px; height: 11px; }

  .hrc-actions { margin-top: 12px; }
  .hrc-btn { height: 36px; line-height: 36px; }
  .hrc-btn + .hrc-btn { margin-left: 10px; }
  .hrc-btn-outline { border-width: 1px; }
  .hrc-btn-locked { border-width: 1px; }

  .hrc-add { margin-top: 10px; }

  .hrc-ai-fail { margin-top: 10px; padding: 10px 12px; }
  .hrc-ai-box { margin-top: 10px; padding: 12px; }
  .hrc-ai-sec { margin-top: 8px; }
  .hrc-ai-sec-b { margin-top: 2px; }
  .hrc-ai-dis { margin-top: 8px; padding-top: 6px; border-top-width: 1px; }

  .hrc-secure { margin-top: 9px; }
}
