/**
 * consultation.wxss —— AI 问诊（对话 + 分诊结果卡）
 *
 * 版式对齐 design-output/患者端/B-TabBar补充/04-AI问诊首页.png（逐项见 WXML 顶部注释）。
 * 色彩纪律：本页只引用 app.wxss 的令牌；仅语义色（白字 / 遮罩）出现字面 rgb。
 * 图标纪律：图标全部来自 utils/icons.js（图内 emoji 一律不用）。
 *
 * ⚠️ 尺寸口径：手机档写 rpx；**每一处硬编码 rpx 都必须**在文件末尾的平板断点块里再写一份 px
 *    （= rpx ÷ 2），否则宽屏会被等比放大。这是首页 / 导诊 / 预约挂号三页统一的平板口径，
 *    改动样式后请同步检查该块（可用脚本核对：基础段里含 rpx 的选择器是否都在块内出现）。
 *    （注：注释里刻意不写 at-rule 关键字，避免外部构建脚本按关键字切块时误伤本文件。）
 */
.consult-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  /* 顶部淡蓝 → 44% 处收到页面底 --bg（与首页/导诊页同一基调） */
  background: linear-gradient(180deg, #D9EEFE 0%, var(--bg) 44%);
}

/* ============ 双栏外壳（手机=纵向单列） ============ */
.consult-cols {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.consult-side { flex-shrink: 0; }

.consult-main {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

/* ============ 顶部：分段 Tab ============
   F-2 闭环：navigationStyle=custom 时右侧控件会被微信胶囊压住 ——
   安全宽由 JS 注入（inline padding-right），本处只负责结构。 */
.nav-bar {
  display: flex;
  align-items: center;
  padding-left: 24rpx;
  padding-right: 24rpx;
  padding-bottom: 16rpx;
  flex-shrink: 0;
}

.nav-tabs {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: flex-end;
  justify-content: flex-start;
  gap: 48rpx;
}

/* 复刻文档 §四.4：选中蓝字 + 底部蓝下划线（56rpx × 6rpx，圆角）；未选中灰蓝 */
.nav-tab {
  position: relative;
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--text-sub);
  padding: 6rpx 0 12rpx;
}

.nav-tab-on {
  color: var(--primary);
  font-weight: 700;
}

.nav-tab-on::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 56rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--primary);
}

/* 「清空 🗑」：文字 + 垃圾桶图标，位于大标题行右侧 */
.nav-clear {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  min-height: 88rpx;
  padding: 0 4rpx 0 12rpx;
  font-size: calc(var(--font-caption) + 2rpx);
  color: var(--text-sub);
}

.nav-clear-ic {
  width: 32rpx;
  height: 32rpx;
  margin-left: 8rpx;
}

.nav-clear:active { color: var(--primary); }

/* ============ ① 标题区 ============ */
.ask-hero {
  padding: 8rpx 0 24rpx;
}

.ask-hero-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 复刻文档 §四.4-①：48rpx 起 / 700 / 深蓝 = --font-title(40rpx) + --hero-title-boost(8rpx)。
   ⚠️ 加码必须走令牌：写死 `+8rpx` 在宽屏会被等比放大（1200px 视口 8rpx≈13px），
   app.wxss 已把该令牌在 ≥600px 改成 4px。 */
.ask-hero-t {
  font-size: calc(var(--font-title) + var(--hero-title-boost));
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.25;
}

/* 副标题：28rpx 灰蓝 */
.ask-hero-s {
  margin-top: 10rpx;
  font-size: calc(var(--font-body) - 2rpx);
  color: var(--text-sub);
  line-height: 1.5;
}

/* 上次问诊（有历史才出现；本次新增的恢复入口，效果图无此元素） */
.last-consult {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  min-height: 64rpx;
}

.last-consult-t {
  font-size: var(--font-caption);
  color: var(--text-sub);
}

.last-consult-ic {
  width: 22rpx;
  height: 22rpx;
  margin-left: 6rpx;
  opacity: 0.5;
}

/* ============ 主体滚动区 ============ */
.body-scroll {
  flex: 1;
  min-height: 0;   /* flex 项默认最小高度=内容高度，不解除则滚动区顶破容器 */
  overflow: hidden;
  padding: 0 24rpx;
  box-sizing: border-box;
}

/* ============ 用户信息条 ============ */
.user-strip {
  display: flex;
  align-items: center;
  background: var(--card);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.user-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--accent-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.user-strip-info { flex: 1; margin-left: 20rpx; }

.user-strip-name {
  font-size: var(--font-body);
  font-weight: 700;
  color: var(--text-main);
}

.user-gender {
  font-size: var(--font-caption);
  font-weight: 500;
  color: var(--text-sub);
}

.user-strip-id {
  margin-top: 4rpx;
  font-size: calc(var(--font-caption) + 2rpx);
  color: var(--text-sub);
}

.user-switch {
  font-size: calc(var(--font-caption) + 2rpx);
  color: var(--text-sub);
  min-height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 0 0 16rpx;
}

/* ============ ② 对话区（气泡规范与导诊页一致） ============ */
.chat-list {
  padding-bottom: 24rpx;
}

.msg {
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
}

.msg-user { align-items: flex-end; }
.msg-ai { align-items: flex-start; }

/* 行内横向关系交给 .msg-row（.msg 仍是纵向容器，时间戳靠它居中） */
.msg-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  width: 100%;
  box-sizing: border-box;
}

.msg-user .msg-row { justify-content: flex-end; }

/* AI 头像：圆形蓝底 + 「AI」白字（设计 04 的 AI 徽标） */
.ai-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 4rpx;
  flex-shrink: 0;
}

.ai-avatar text {
  font-size: 20rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 1rpx;
}

.msg-in { animation: msgIn 300ms ease-out both; }

@keyframes msgIn {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.msg-bubble {
  max-width: 78%;
  padding: 22rpx 28rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-body);
  line-height: 1.7;
  word-break: break-all;
}

/* 用户气泡：主蓝实心 + 右下小尾巴（与导诊页 .bubble-user 同一实现） */
.bubble-user {
  position: relative;
  background: var(--primary);
  color: #FFFFFF;
  border-bottom-right-radius: 8rpx;
}

.bubble-user::after {
  content: '';
  position: absolute;
  right: -10rpx;
  bottom: 0;
  width: 0;
  height: 0;
  border-left: 14rpx solid var(--primary);
  border-top: 14rpx solid transparent;
  border-bottom: 0;
}

/* AI 气泡：浅蓝底 --accent-soft（设计实测 #ECF5FF）；不用白底+投影，
   否则与页内白卡混为一层。左侧已被头像占掉一列 → 气泡直接占满剩余行宽。 */
.bubble-ai {
  max-width: 100%;
  background: var(--accent-soft);
  color: var(--text-main);
  border-bottom-left-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.bubble-ai .msg-replay { align-self: flex-end; }

/* 重新播放（TTS） */
.msg-replay {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  background: var(--card);
  color: var(--primary);
  border-radius: 999rpx;
  font-size: calc(var(--font-caption) + 2rpx);
  font-weight: 500;
}

.msg-time {
  align-self: center;
  margin-top: 8rpx;
  font-size: calc(var(--font-caption) + 2rpx);
  color: var(--text-sub);
}

/* ============ ③ 分诊结果卡（设计 04） ============ */
.res-card {
  width: 100%;
  background: var(--card);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  box-shadow: var(--shadow-card);
  box-sizing: border-box;
}

.res-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

/* 「分诊结果」蓝色大字 */
.res-title {
  font-size: var(--font-h2);
  font-weight: 700;
  color: var(--primary);
  line-height: 1.3;
}

/* 内容行：左标签 chip + 右内容 */
.res-row {
  display: flex;
  align-items: flex-start;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border);
}

.res-k {
  flex-shrink: 0;
  min-width: 112rpx;
  margin-right: 20rpx;
  padding: 6rpx 16rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  background: var(--bg);
  font-size: var(--font-caption);
  color: var(--text-sub);
  text-align: center;
  line-height: 1.4;
}

.res-v {
  flex: 1;
  min-width: 0;
}

.res-dept {
  font-size: calc(var(--font-body) + 2rpx);
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.4;
}

.res-alts {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.res-alts-t {
  font-size: var(--font-caption);
  color: var(--text-sub);
}

.res-alt {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: var(--accent-soft);
  font-size: var(--font-caption);
  color: var(--primary);
}

.res-reason {
  font-size: calc(var(--font-body) - 2rpx);
  color: var(--text-main);
  line-height: 1.7;
}

/* 双按钮：左描边「查看科室」/ 右实心「去预约」 */
.res-ops {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border);
}

.res-btn {
  min-width: 200rpx;
  height: 72rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-body);
  font-weight: 600;
}

.res-btn-ghost {
  border: 2rpx solid var(--primary);
  color: var(--primary);
  background: var(--card);
}

.res-btn-ghost:active { background: var(--accent-soft); }

.res-btn-main {
  background: var(--primary);
  color: #FFFFFF;
}

.res-btn-main:active { background: var(--primary-dark); }

/* 底部合规文案 + 赞踩：**同一行流式排布**（不用绝对定位 —— 文案一长就会被图标压住）。
   文案 flex:1 居中；赞踩靠右，占位固定，永远不重叠。 */
.res-foot {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--border);
}

.res-note {
  flex: 1;
  min-width: 0;
  font-size: var(--font-caption);
  color: var(--text-sub);
  text-align: center;
  line-height: 1.5;
}

.ai-fb {
  flex-shrink: 0;
  margin-left: 12rpx;
  display: flex;
  gap: 12rpx;
}

.fb-btn {
  width: 36rpx;
  height: 36rpx;
  padding: 6rpx 8rpx;
  border-radius: 10rpx;
  background: var(--accent-soft);
}

/* ============ ④ 就医进度卡 ============
   ⚠️ .flow-card / .flow-main / .flow-info / .flow-title / .flow-sub / .flow-doc /
   .flow-steps / .flow-step / .flow-dot* / .flow-check / .flow-line* / .flow-labels /
   .flow-label* / .flow-detail-btn 全部在 app.wxss 有唯一实现（与导诊页共用）——
   此处只补本页的定位与页边距，**不要重建副本**。 */
.flow-zone {
  flex-shrink: 0;
  padding: 0 0 24rpx;
}

/* ============ 路线询问卡 ============ */
.navask-card {
  width: 100%;
  box-sizing: border-box;
  padding: 22rpx 24rpx;
  border-radius: var(--radius-lg);
  background: var(--accent-soft);
  border: 2rpx solid var(--accent-press);
}

.navask-q {
  display: flex;
  align-items: flex-start;
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--text-main);
  line-height: 1.6;
}

.navask-q .ic-sm { margin-right: 10rpx; flex-shrink: 0; }

.navask-ops {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.navask-op {
  flex: 1;
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: var(--card);
  color: var(--primary);
  font-size: var(--font-caption);
  font-weight: 600;
  box-sizing: border-box;
}

.navask-op + .navask-op { margin-left: 12rpx; }

.navask-op-main {
  background: var(--primary);
  color: #FFFFFF;
}

.navask-op-main:active { background: var(--primary-dark); }

/* ============ 首屏快捷症状 ============ */
.quick-chips {
  display: flex;
  flex-wrap: wrap;
  margin: 4rpx 0 16rpx;
}

.chip {
  padding: 14rpx 26rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 999rpx;
  background: var(--accent-soft);
  color: var(--primary);
  font-size: var(--font-caption);
  font-weight: 600;
  /* 触控红线 88rpx=44px，取 80rpx=40px（D-B-P2-04：原 68rpx=34px） */
  min-height: 80rpx;
  display: flex;
  align-items: center;
}

.chip:active { background: var(--accent-press); }

/* ============ 急诊预警条（红旗命中才出现 → 真实高风险，保持红色语义） ============ */
.emergency-bar {
  display: flex;
  align-items: center;
  background: var(--danger-soft);
  color: var(--danger-text);
  border-radius: var(--radius-sm);
  padding: 18rpx 22rpx;
  font-size: var(--font-body);
  font-weight: 600;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

.emergency-text { flex: 1; }

.emergency-call {
  flex-shrink: 0;
  margin-left: 16rpx;
  min-width: 152rpx;
  /* 高风险动作按钮不得小于红線（D-B-P2-04：原 72rpx=36px） */
  min-height: 88rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: var(--accent-red);
  color: #FFFFFF;
  font-size: var(--font-caption);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.emergency-call:active { background: var(--danger-text); }

/* ============ 思考中 ============ */
.thinking-bubble {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 28rpx;
  background: var(--card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
}

.spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid var(--border);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
  flex-shrink: 0;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.thinking-text {
  font-size: calc(var(--font-caption) + 2rpx);
  color: var(--text-sub);
}

.anchor { height: 4rpx; }

/* ============ 页面级合规提示 / 快捷服务行 ============ */
.consult-note {
  margin: 0 24rpx 8rpx;
  flex-shrink: 0;
}

.quick-services {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx 20rpx;
  padding: 16rpx 24rpx;
  flex-shrink: 0;
}

.qs-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: var(--card);
  border-radius: 999rpx;
  padding: 12rpx 22rpx;
  font-size: calc(var(--font-caption) + 2rpx);
  color: var(--text-main);
  flex-shrink: 0;
  box-shadow: var(--shadow-card);
}

/* ============ ⑤ 橙色警示条 ============ */
.safety-bar {
  display: flex;
  align-items: center;
  margin: 0 24rpx 12rpx;
  padding: 16rpx 22rpx;
  background: var(--amber-soft);
  border-radius: var(--radius-md);
  flex-shrink: 0;
}

.safety-ic {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.safety-text {
  flex: 1;
  min-width: 0;
  font-size: var(--font-caption);
  font-weight: 600;
  color: var(--amber-text);
  line-height: 1.5;
}

.safety-call {
  flex-shrink: 0;
  margin-left: 16rpx;
  min-height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--accent-amber);
  color: #FFFFFF;
  font-size: calc(var(--font-caption) + 2rpx);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.safety-call:active { background: var(--amber-text); }

/* ============ ⑥ 底部输入栏 ============ */
.input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(100rpx + env(safe-area-inset-bottom));
  background: var(--card);
  flex-shrink: 0;
}

.input-wrap {
  flex: 1;
  min-width: 0;
  height: var(--btn-height);
  display: flex;
  align-items: center;
  background: var(--bg);
  border-radius: 999rpx;
  padding: 0 12rpx 0 28rpx;
}

.input-wrap-on { background: var(--accent-press); }

.voice-btn {
  /* 语音输入圆钮：嵌在 88rpx 输入行内，40px 为可行上限（D-B-P2-04：原 64rpx=32px） */
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.input-field {
  flex: 1;
  min-width: 0;
  height: var(--btn-height);
  font-size: var(--font-body);
  color: var(--text-main);
}

.ph { color: var(--text-placeholder); }

/* 蓝色圆角方发送按钮（设计 04：纸飞机） */
.send-fab {
  width: var(--btn-height);
  height: var(--btn-height);
  border-radius: 24rpx;
  background: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.send-fab-disabled { background: var(--disabled-bg); }

.send-icon {
  width: 40rpx;
  height: 40rpx;
}

.voice-hint {
  position: fixed;
  left: 50%;
  bottom: calc(220rpx + env(safe-area-inset-bottom));
  transform: translateX(-50%);
  background: rgba(29, 33, 41, 0.8);
  color: #FFFFFF;
  border-radius: 999rpx;
  padding: 14rpx 32rpx;
  font-size: var(--font-caption);
  z-index: 30;
}

/* ============ 「查看科室」半模态 ============ */
.dept-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 55;
  background: rgba(20, 38, 76, 0.2);
}

.dept-sheet {
  z-index: 60;
}

.dept-sheet-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
}

.dept-sheet-k {
  flex-shrink: 0;
  width: 96rpx;
  font-size: var(--font-body);
  color: var(--text-sub);
}

.dept-sheet-v {
  flex: 1;
  min-width: 0;
  font-size: var(--font-body);
  color: var(--text-main);
  line-height: 1.6;
}

.dept-sheet-ops {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

/* ============ 平板右栏「就医助手」（仅 .side-only 可见） ============ */
.consult-helper {
  margin-top: 0;
  padding: 24rpx;
  background: var(--card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.helper-head {
  font-size: calc(var(--font-caption) + 2rpx);
  color: var(--text-sub);
}

.helper-dept {
  margin-top: 8rpx;
  font-size: var(--font-title);
  font-weight: 700;
  color: var(--primary-dark);
  line-height: 1.3;
}

.helper-tags {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.helper-conf {
  font-size: var(--font-caption);
  color: var(--text-sub);
}

.helper-advice {
  margin-top: 14rpx;
  font-size: var(--font-caption);
  color: var(--text-sub);
  line-height: 1.7;
}

.helper-ops {
  display: flex;
  margin-top: 20rpx;
}

.helper-op {
  flex: 1;
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: var(--primary);
  color: #FFFFFF;
  font-size: var(--font-caption);
  font-weight: 700;
}

.helper-op:active { background: var(--primary-dark); }

.helper-op-ghost {
  margin-left: 12rpx;
  background: var(--card);
  color: var(--primary);
  border: 2rpx solid var(--primary);
}

.helper-op-ghost:active { background: var(--accent-soft); }

/* =====================================================================
   平板档（≥600px）：本页所有**硬编码 rpx 尺寸**逐条 px 化（rpx ÷ 2）。
   口径与首页 / 导诊 / 预约挂号三页一致。缺一条就会在宽屏上被放大近一倍。
   ===================================================================== */
@media (min-width: 600px) {
  /* 字号：本页凡是用 calc(var(--font-*) ± Nrpx) 写的地方，宽屏下那段 rpx 不会跟着令牌缩，
     一律在此给出 375 基准的等价 px（= 手机 rpx ÷ 2），避免「令牌 13px + 8rpx≈13px」的失控。 */
  .nav-clear { min-height: 44px; padding: 0 2px 0 6px; font-size: 13px; }
  .ask-hero-s { font-size: 14px; margin-top: 5px; }
  .user-strip-id { font-size: 13px; }
  .user-switch { font-size: 13px; }
  .msg-replay { font-size: 13px; }
  .msg-time { font-size: 13px; }
  .thinking-text { font-size: 13px; }
  .helper-head { font-size: 13px; }
  .qs-item { font-size: 13px; }
  .safety-call { font-size: 13px; }
  .res-dept { font-size: 16px; }
  .res-reason { font-size: 14px; }

  .nav-bar { padding-left: 12px; padding-right: 12px; padding-bottom: 8px; }
  .nav-tabs { gap: 24px; }
  .nav-tab { padding: 3px 0 6px; }
  .nav-tab-on::after { width: 28px; height: 3px; border-radius: 2px; }
  .nav-clear-ic { width: 16px; height: 16px; margin-left: 4px; }

  .ask-hero { padding: 4px 0 12px; }
  .last-consult { margin-top: 5px; min-height: 32px; }
  .last-consult-ic { width: 11px; height: 11px; margin-left: 3px; }

  .body-scroll { padding: 0 12px; }

  .user-strip { padding: 10px 12px; margin-bottom: 10px; }
  .user-avatar { width: 36px; height: 36px; }
  .user-strip-info { margin-left: 10px; }
  .user-strip-id { margin-top: 2px; }
  .user-switch { min-height: 44px; padding: 0 0 0 8px; }

  .chat-list { padding-bottom: 12px; }
  .msg { margin-bottom: 12px; }
  .msg-row { gap: 6px; }
  .ai-avatar { width: 28px; height: 28px; margin-top: 2px; }
  .ai-avatar text { font-size: 10px; letter-spacing: 0.5px; }
  .msg-bubble { padding: 11px 14px; }
  .bubble-user::after {
    right: -5px;
    border-left: 7px solid var(--primary);
    border-top: 7px solid transparent;
  }
  .msg-replay { margin-top: 5px; padding: 3px 8px; }
  .msg-time { margin-top: 4px; }

  .res-card { padding: 14px; }
  .res-head { gap: 8px; }
  .res-row { margin-top: 10px; padding-top: 10px; border-top-width: 1px; }
  .res-k { min-width: 56px; margin-right: 10px; padding: 3px 8px; border-radius: 4px; }
  .res-alts { gap: 5px; margin-top: 5px; }
  .res-alt { padding: 2px 7px; }
  .res-ops { margin-top: 12px; padding-top: 10px; border-top-width: 1px; }
  .res-btn { min-width: 100px; height: 36px; padding: 0 16px; border-width: 1px; }
  .res-foot { margin-top: 11px; padding-top: 9px; border-top-width: 1px; }
  .ai-fb { gap: 6px; }
  .fb-btn { width: 18px; height: 18px; padding: 3px 4px; border-radius: 5px; }

  .flow-zone { padding: 0 0 12px; }

  .navask-card { padding: 11px 12px; }
  .navask-q .ic-sm { margin-right: 5px; }
  .navask-ops { margin-top: 9px; }
  .navask-op { min-height: 40px; }
  .navask-op + .navask-op { margin-left: 6px; }

  .quick-chips { margin: 2px 0 8px; }
  .chip { padding: 7px 13px; margin: 0 8px 8px 0; min-height: 40px; }

  .emergency-bar { padding: 9px 11px; margin-bottom: 12px; }
  .emergency-call { margin-left: 8px; min-width: 76px; min-height: 44px; padding: 0 10px; }

  .thinking-bubble { padding: 12px 14px; gap: 6px; }
  .spinner { width: 16px; height: 16px; border-width: 2px; }
  .anchor { height: 2px; }

  .consult-note { margin: 0 12px 4px; }
  .quick-services { gap: 8px 10px; padding: 8px 12px; }
  .qs-item { gap: 4px; padding: 6px 11px; }

  .safety-bar { margin: 0 12px 6px; padding: 8px 11px; }
  .safety-ic { width: 18px; height: 18px; margin-right: 6px; }
  .safety-call { margin-left: 8px; min-height: 32px; padding: 0 14px; }

  .input-bar { gap: 8px; padding: 8px 12px calc(50px + env(safe-area-inset-bottom)); }
  .input-wrap { padding: 0 6px 0 14px; }
  .voice-btn { width: 40px; height: 40px; }
  .send-fab { border-radius: 12px; }
  .send-icon { width: 20px; height: 20px; }
  .voice-hint { bottom: 110px; padding: 7px 16px; }

  .dept-sheet-row { padding: 8px 0; }
  .dept-sheet-k { width: 48px; }
  .dept-sheet-ops { margin-top: 8px; }

  .consult-helper { padding: 12px; }
  .helper-dept { margin-top: 4px; }
  .helper-tags { gap: 6px; margin-top: 6px; }
  .helper-advice { margin-top: 7px; }
  .helper-ops { margin-top: 10px; }
  .helper-op { min-height: 38px; }
  .helper-op-ghost { margin-left: 6px; border-width: 1px; }
}

/* =====================================================================
   平板**横屏**（≥900px 且 ≥700px 且横屏）：双栏布局。
   ⚠️ 高度条件排除横向手机；**横屏**条件排除平板竖屏（竖屏排双栏会把
   对话区挤窄、下方留大片空白）→ 竖屏走单列 + 720px 限宽（app.wxss）。
   尺寸已由上一条 ≥600px 块 px 化，此处只写**布局**差异。
   ===================================================================== */
@media (min-width: 900px) and (min-height: 700px) and (orientation: landscape) {
  .page.consult-page { max-width: 1180px; }

  .consult-cols {
    flex-direction: row;
    align-items: stretch;
    gap: 24px;
  }

  .consult-main {
    flex: 1 1 auto;
    min-width: 0;
  }

  /* 侧栏放到右边：手机上该栏在 DOM 最前（进度/助手在上），只能靠 order 翻转 */
  .consult-side {
    order: 2;
    flex: 0 0 360px;
    width: 360px;
    overflow-y: auto;
  }

  /* 左右列已改内容宽 → 页级左右内边距归零。
     ⚠️ padding-right 仍会被 .nav-bar 的 inline 样式（胶囊安全宽）覆盖，这是**有意的**。 */
  .nav-bar { padding-left: 0; }
  .body-scroll { padding: 0; }
  .flow-zone { padding: 0 0 12px; }
  .consult-note { margin: 0 0 4px; }
  .quick-services { padding: 8px 0 0; gap: 12px; }
  .safety-bar { margin: 0 0 6px; }
  .input-bar { padding: 12px 0 0; border-top: 1px solid var(--border); }
  .consult-helper { margin-top: 0; }
}
