/* 骨架屏 —— 灰色块 + opacity 脉冲（符合「动画只动 opacity」规范） */
.sk {
  width: 100%;
}

.sk-block {
  background: #EDF0F4;
  border-radius: 8rpx;
  animation: sk-blink 1.2s ease-in-out infinite;
}

@keyframes sk-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.45; }
}

/* ---------- list ---------- */
.sk-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.sk-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sk-line-lg { height: 40rpx; width: 60%; }
.sk-line-sm { height: 32rpx; width: 80%; margin-top: 20rpx; }
.sk-line-xs { height: 28rpx; width: 40%; margin-top: 16rpx; }
.sk-badge   { height: 36rpx; width: 120rpx; border-radius: 999rpx; }

/* ---------- stats ---------- */
.sk-stats {
  display: flex;
  margin-bottom: 24rpx;
}

.sk-stat {
  flex: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 20rpx;
}

.sk-stat:last-child { margin-right: 0; }
.sk-num   { height: 64rpx; width: 80rpx; }
.sk-label { height: 28rpx; width: 100rpx; margin-top: 16rpx; }

/* ---------- card ---------- */
.sk-avatar { width: 88rpx; height: 88rpx; border-radius: 50%; }
.sk-col    { flex: 1; margin-left: 24rpx; }
.sk-line   { height: 28rpx; width: 100%; margin-top: 20rpx; }
.sk-btn    { height: 80rpx; width: 100%; border-radius: 16rpx; margin-top: 28rpx; }
