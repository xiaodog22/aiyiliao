# backend/deploy/env.example
# 复制为 env.local 并填写；env.local 不得入库。
# 一键启动时会把这些变量注入各服务子进程；脚本只打印键的个数，不显示内容。
# 变量名以 Agent-M 登记（business-service/README.md §环境变量清单，I-3 契约）为准。

# --- 业务服务 business-service（Spring Boot）---
# MYSQL_PASSWORD 无默认值（业务为 MySQL 硬依赖，连不上即启动失败，不降级掩盖）——本地 dev 必须填写。
MYSQL_URL=jdbc:mysql://127.0.0.1:3306/wechar_dev?useUnicode=true&characterEncoding=UTF-8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
MYSQL_USER=wechar_dev
MYSQL_PASSWORD=
# SERVER_PORT=8088
# SPRING_PROFILES_ACTIVE=dev

# --- 资源库（V14：图片/图标元数据在 resource_asset 表，二进制在文件系统，不存 BLOB）---
# public-base-url 配置后，资源清单 items[].url = {base}/api/v1/resources/{key}（绝对 HTTPS）。
# **留空 = url 全为 null**（前端回退包内 bundlePath，与改造前一致，可作灰度回滚开关）。
# 小程序后台 downloadFile 合法域名必须与之同源，否则真机 <image>/downloadFile 被拒。
# APP_RESOURCES_PUBLIC_BASE_URL=https://qv56gv32944.vicp.fun
# 资源根目录：默认相对 business-service 工作目录（../deploy/resources）。
# ⚠️ 若从仓库根直接 `java -jar`，必须传绝对路径，否则路径穿越防护的根会错、资源全 404。
# APP_RESOURCES_DIR=

# --- 健康档案附件签名与限额（V9；2026-10-19 支持 mp4）---
# sign-secret 生产必须固定、多实例必须一致。不配则代码进程内随机：
# 重启后已签发 URL 全部失效（15 分钟内打开过的图片/视频会 403），多实例 A 签 B 验必 403。
# 本地开发也建议固定，避免每次重启测试链接失效。
# APP_ATTACHMENT_SIGN_SECRET=
# 图片/PDF 上限（字节），默认 10MB。视频用单独一项，不要用视频上限去放开图片/PDF。
# APP_ATTACHMENT_MAX_BYTES=10485760
# APP_ATTACHMENT_VIDEO_MAX_BYTES=52428800
# 签名 TTL（秒）：图片/PDF 15 分钟；视频 2 小时。
# 视频 TTL 要覆盖「打开详情 → 停留 → 完整播放 → 拖动」；过期后再拖动会 403，前端需重新拉详情换新 URL。
# APP_ATTACHMENT_URL_TTL_SECONDS=900
# APP_ATTACHMENT_VIDEO_TTL_SECONDS=7200

# --- 健康档案附件签名与限额（V9；2026-10-19 支持 mp4）---
# ⚠️ sign-secret 生产必须固定、**多实例必须一致**。不配则代码进程内随机：
#    重启后已签发的 URL 全部失效（15 分钟内打开过的图片/视频会 403），多实例 A 签 B 验必 403。
#    本地开发也建议固定，避免每次重启测试链接失效。
# APP_ATTACHMENT_SIGN_SECRET=
# 图片/PDF 上限（字节），默认 10MB。视频用单独一项，**不要**用视频上限去放开图片/PDF。
# APP_ATTACHMENT_MAX_BYTES=10485760
# APP_ATTACHMENT_VIDEO_MAX_BYTES=52428800
# 签名 TTL（秒）：图片/PDF 15 分钟；视频 2 小时。
# 视频 TTL 要覆盖「打开详情 → 停留 → 完整播放 → 拖动」；过期后再拖动会 403，前端需重新拉详情换新 URL。
# APP_ATTACHMENT_URL_TTL_SECONDS=900
# APP_ATTACHMENT_VIDEO_TTL_SECONDS=7200

# --- 前置检查用（MySQL 可达性探测；不填则用 config.json 的 127.0.0.1:3306）---
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306

# --- 微信小程序登录（生产必需；不填则登录 503 WECHAT_PROVIDER_UNAVAILABLE）---
# AppID/AppSecret 由运维在部署环境注入，**不得写入本文件、源码或测试夹具**。
# 本地 dev 档用 DevWechatSessionProvider（假数据），无需这两项。
# WECHAT_MINIPROGRAM_APP_ID=
# WECHAT_MINIPROGRAM_APP_SECRET=
# 仅隔离联调时可改基址/超时（默认 https://api.weixin.qq.com，建连 3000ms / 读取 5000ms）
# WECHAT_MINIPROGRAM_API_BASE_URL=
# WECHAT_MINIPROGRAM_CONNECT_TIMEOUT_MS=3000
# WECHAT_MINIPROGRAM_READ_TIMEOUT_MS=5000

# --- AI 服务（可选）---
# AI_AUTH_MODE=off            # off=开发档；static=固定令牌（配合 AI_SERVICE_TOKEN）
# AI_SERVICE_TOKEN=
# AI_OLLAMA_URL=http://127.0.0.1:11434

# --- 语音合成 TTS：引擎与产物可达基址（M2/D2.3；O-10 已定稿 2026-10-15）---
# 引擎：edge=edge-tts（生产默认：轻量、外部依赖少、首包快）；none=未配置（→ TTS_UNAVAILABLE，不播占位音）。
# 仅当对音色自然度/情感表现要求极高时，才考虑换 Qwen3-TTS（需另接适配器，见 ai-service README）。
AI_TTS_ENGINE=edge
# audioUrl 的**客户端可达基址**：ai-service 仅内网可达（/internal/**），客户端拿不到内网地址，
# 故 base 必须指向「客户端能访问、且已转发 TTS 产物路径」的对外入口；经网关单入口时 = 网关对外域名。
# 不设时落回内网默认 http://127.0.0.1:8001（仅供本机自测，真机不可达）。
AI_TTS_PUBLIC_BASE=
# 该入口下转发到 ai-service 内部签名通道的公开路径（网关公开通道：/api/gw/tts/audio/{filename}）
AI_TTS_PUBLIC_PATH=/api/gw/tts/audio
# 短期签名密钥：留空则每次启动随机生成（重启后旧音频 URL 失效，符合“短期”语义）
# AI_TTS_URL_SECRET=
# 音色映射（可选，逗号分隔）：业务音色ID=引擎音色，未命中回落到 AI_TTS_DEFAULT_VOICE，不报错
# AI_TTS_VOICE_MAP=qwen3-female-1=zh-CN-XiaoxiaoNeural
# AI_TTS_DEFAULT_VOICE=zh-CN-XiaoxiaoNeural

# --- AI 内容寻址缓存（M2/D2.4；默认关）---
# 开启后：「同输入+同模型+同模板/策略/音色/参数」的生成类任务（TRIAGE/CHAT/CARE_PLAN）直接复用安全结果，省算力。
# 缓存非权威数据（权威在 MySQL），Redis 缺失时退化为本机 JSON 文件，重启可失。
# AI_CACHE_ENABLED=true
# AI_CACHE_PATH=./runtime/cache.json
# AI_CACHE_TTL_SECONDS=3600
# AI_TENANT_SECRET=          # HMAC 租户密钥；留空则每次启动随机（重启即失效旧条目）
#
# ⚠️ O-03 铁律（权限先于缓存命中，用户裁定 2026-10-15）：
#    ai-service 仅内网 /internal/** 可达，缓存命中发生在 business-service 完成
#    租户隔离/鉴权/角色校验**之后**的任务受理流程内；缓存键本身含 tenantId。
#    不得把缓存下沉到网关或任何对客户端暴露的路径上——否则会绕过鉴权、可被构造同
#    inputDigest 命中越权数据。

# --- 语音识别 ASR（M2/D2.3；默认未配置）---
# AI_ASR_ENGINE=funasr        # none=未配置（→ CAPABILITY_UNAVAILABLE，不伪造转写）/ funasr=本地权重
# AI_ASR_MODEL_PATH=          # FunASR 权重目录（不存在 → 能力如实不可用）
# AI_ASR_AUDIO_DIR=           # 音频引用目录（inputRef=asr:{id} → {id}.wav|mp3|m4a|pcm|ogg|webm）
#                              ⚠️ 该目录由 business-service（Java）写入、ai-service 只读，
#                              两端读的是同一个 AI_ASR_AUDIO_DIR，值必须一致；不一致 → 取不到音频即降级。

# --- 运行产物回收与保留（M4 硬化前瞻，提前到 M3）---
# 周期清理（sweep）会：① 把超时未终结的任务推进为 EXPIRED；② 裁剪超过保留期的历史任务；
# ③ 回收「未被在库任务引用 + 已过 TTL」的 TTS 产物。全部为**非权威中间态**，回收不影响正确性。
# AI_TASK_RETENTION_SECONDS=86400   # 历史任务保留期（超出即裁剪）
# AI_SWEEP_INTERVAL_SECONDS=60      # 周期清理间隔；0=关闭周期清理（仍有「每 50 任务」兜底裁剪）
# AI_TTS_ARTIFACT_TTL_SECONDS=3600  # TTS 产物保留期（未被引用且超时的 .mp3 才回收）

# --- 网关（可选）---
# GW_LOG_LEVEL=INFO

# --- 网关限流（M4 硬化前瞻，提前到 M3；默认关）---
# 固定窗口限流，按「客户端标识（X-Forwarded-For 首跳 / 直连地址）」计数；定位是保护上游，不是配额计费。
# 探针路径（/health、/api/gw/health）**不参与**限流——否则编排器健康轮询会被自己限死。
# 命中 → 429 + 统一错误信封（code=RATE_LIMITED）+ Retry-After。
# GW_RATE_LIMIT_ENABLED=false
# GW_RATE_LIMIT_PER_MINUTE=300
# GW_RATE_LIMIT_WINDOW_SECONDS=60

# --- 网关静态素材公开通道（前端适配：素材经后端传递，docs/v4/09 §4.2）---
# 白名单图片经统一入口分发（/api/gw/assets/{filename}，ETag/304 + sha256 头）；
# 目录也可用 config.json.assets.dir（默认 backend/deploy/resources），相对路径以仓库根为基准。
# GW_ASSETS_DIR=backend/deploy/resources

# --- 网关 legacy 兼容登录开关（安全默认关闭）---
# 控制条目 POST /api/user/login（dev 替身：用派生 dev code 换取会话，不做密码校验）。
# **默认 false = 404**：生产严禁开启（x-migration 已声明生产不得使用 dev 合成身份通道）。
# 仅本地/联调环境在 deploy/config.json 显式置 "compat": { "legacyLoginEnabled": true }。
# GW_LEGACY_LOGIN_ENABLED=true
