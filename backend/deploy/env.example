# backend/deploy/env.example
# 复制为 env.local 并填写；env.local 不得入库。
# 一键启动时会把这些变量注入各服务子进程；脚本只打印键的个数，不显示内容。
# 变量名以 Agent-M 登记（business-service/README.md §环境变量清单，I-3 契约）为准。

# --- 统一网关（云托管 / 容器部署必须显式注入，勿依赖代码默认值）---
# 2026-11-10：config.py 默认虽为 220s，但 CLOUD.md §3 要求「保持 220，不得下调」且显式注入。
# 链路预算：ai 150s < business 165s < 前端 180s < 网关 220s；下调会让 careplan 被网关先掐断。
GW_PROXY_TIMEOUT_SECONDS=220

# --- 业务服务 business-service（Spring Boot）---
# MYSQL_PASSWORD 无默认值（业务为 MySQL 硬依赖，连不上即启动失败，不降级掩盖）——本地 dev 必须填写。
MYSQL_URL=jdbc:mysql://127.0.0.1:3306/wechar_dev?useUnicode=true&characterEncoding=UTF-8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
MYSQL_USER=wechar_dev
MYSQL_PASSWORD=
# SERVER_PORT=8088
# SPRING_PROFILES_ACTIVE=dev

# --- 资源库（V14：图片/图标元数据在 resource_asset 表，二进制在文件系统，不存 BLOB）---
# public-base-url 配置后，资源清单 items[].url = {base}/api/v1/resources/{key}（绝对 HTTPS）。
# **留空 = url 全为 null**（前端回退包内 bundlePath，与改造前一致，可作灰度回滚开关）。
# 小程序后台 downloadFile 合法域名必须与之同源，否则真机 <image>/downloadFile 被拒。
# APP_RESOURCES_PUBLIC_BASE_URL=https://qv56gv32944.vicp.fun
# 资源根目录：默认相对 business-service 工作目录（../deploy/resources）。
# ⚠️ 若从仓库根直接 `java -jar`，必须传绝对路径，否则路径穿越防护的根会错、资源全 404。
# APP_RESOURCES_DIR=

# --- 健康档案附件签名与限额（V9；2026-10-19 支持 mp4）---
# sign-secret 生产必须固定、多实例必须一致。不配则代码进程内随机：
# 重启后已签发 URL 全部失效（15 分钟内打开过的图片/视频会 403），多实例 A 签 B 验必 403。
# 本地开发也建议固定，避免每次重启测试链接失效。
# APP_ATTACHMENT_SIGN_SECRET=
# 图片/PDF 上限（字节），默认 10MB。视频用单独一项，不要用视频上限去放开图片/PDF。
# APP_ATTACHMENT_MAX_BYTES=10485760
# APP_ATTACHMENT_VIDEO_MAX_BYTES=52428800
# 签名 TTL（秒）：图片/PDF 15 分钟；视频 2 小时。
# 视频 TTL 要覆盖「打开详情 → 停留 → 完整播放 → 拖动」；过期后再拖动会 403，前端需重新拉详情换新 URL。
# APP_ATTACHMENT_URL_TTL_SECONDS=900
# APP_ATTACHMENT_VIDEO_TTL_SECONDS=7200

# --- 健康档案附件签名与限额（V9；2026-10-19 支持 mp4）---
# ⚠️ sign-secret 生产必须固定、**多实例必须一致**。不配则代码进程内随机：
#    重启后已签发的 URL 全部失效（15 分钟内打开过的图片/视频会 403），多实例 A 签 B 验必 403。
#    本地开发也建议固定，避免每次重启测试链接失效。
# APP_ATTACHMENT_SIGN_SECRET=
# 图片/PDF 上限（字节），默认 10MB。视频用单独一项，**不要**用视频上限去放开图片/PDF。
# APP_ATTACHMENT_MAX_BYTES=10485760
# APP_ATTACHMENT_VIDEO_MAX_BYTES=52428800
# 签名 TTL（秒）：图片/PDF 15 分钟；视频 2 小时。
# 视频 TTL 要覆盖「打开详情 → 停留 → 完整播放 → 拖动」；过期后再拖动会 403，前端需重新拉详情换新 URL。
# APP_ATTACHMENT_URL_TTL_SECONDS=900
# APP_ATTACHMENT_VIDEO_TTL_SECONDS=7200

# --- 前置检查用（MySQL 可达性探测；不填则用 config.json 的 127.0.0.1:3306）---
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306

# --- 微信小程序登录（生产必需；不填则登录 503 WECHAT_PROVIDER_UNAVAILABLE）---
# AppID/AppSecret 由运维在部署环境注入，**不得写入本文件、源码或测试夹具**。
# 本地 dev 档用 DevWechatSessionProvider（假数据），无需这两项。
# WECHAT_MINIPROGRAM_APP_ID=
# WECHAT_MINIPROGRAM_APP_SECRET=
# 仅隔离联调时可改基址/超时（默认 https://api.weixin.qq.com，建连 3000ms / 读取 5000ms）
# WECHAT_MINIPROGRAM_API_BASE_URL=
# WECHAT_MINIPROGRAM_CONNECT_TIMEOUT_MS=3000
# WECHAT_MINIPROGRAM_READ_TIMEOUT_MS=5000

# --- AI 服务（可选）---
# 仅 static（固定令牌，配合 AI_SERVICE_TOKEN）。off 档（不校验任何令牌）仅供离线排障，
# 不要写进任何会被复制的部署模板（审计 C3）。
# AI_AUTH_MODE=static
# AI_SERVICE_TOKEN=
# AI_OLLAMA_URL=http://127.0.0.1:11434

# --- 2026-11-18 敌意审计整改：新增必配项（缺省值已按 fail-closed 收紧）---
# 短信网关：缺省 application.yml 已反转为 prod（漏配即如实 503，不再"假装已下发"）。
#   联调档必须显式写 dev，否则读不到验证码。
# APP_SMS_PROVIDER=dev
# 验证码摘要密钥（HMAC-SHA256，≥32 字符）：6 位码用无盐 SHA-256 可毫秒级穷举。
#   APP_CODE_HASH_SECRET=
# 手机号 phone_hash 密钥（审计 H2，≥32 字符）：生产必须 HMAC，旧 SHA 行登录时自动升级。
#   APP_PHONE_HMAC_KEY=
# 头像匿名读取短签密钥（审计 M5，≥32 字符）：与附件签名密钥分离。
#   APP_AVATAR_SIGN_SECRET=
# 隐私政策当前版本（审计 M11）：登录携带旧版本 → 409，前端强制重新同意。
#   APP_CONSENT_VERSION=v1.0
# TTS 缓存键 HMAC 密钥：未配置时进程内随机（重启即失效、不可离线预测）。
#   VOICE_CACHE_SECRET=
# 服务间令牌：business 侧缺失/过短会**拒绝启动**（与附件签名密钥同一条红线），
#   两侧（business / ai）必须同值。
#   AI_SERVICE_TOKEN=
# 数据出境策略：默认 domestic = 境外 provider（DeepSeek / 微软 edge-tts）一律否决，
#   医疗数据不出境；仅离线排障才显式设 allow。
#   AI_EGRESS_POLICY=domestic

# --- DeepSeek 兜底（第二级 provider；模板，实际填写在 env.local）---
# 链路 Ollama → DeepSeek → 规则兜底；未配置 key 时该级 fail-fast 跳过，行为与未接入一致。
# ⚠️ 真实 key 只写在 env.local，本模板文件入库，**禁止**在此粘贴任何凭据。
# AI_DEEPSEEK_API_KEY=
# AI_DEEPSEEK_MODEL=deepseek-flash
# AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
# AI_PROVIDER_ORDER=ollama,deepseek
# AI_TRIAGE_DEEPSEEK_TIMEOUT_SECONDS=15
# AI_CHAT_DEEPSEEK_TIMEOUT_SECONDS=20
# AI_CAREPLAN_DEEPSEEK_TIMEOUT_SECONDS=45
# AI_INTERPRET_DEEPSEEK_TIMEOUT_SECONDS=35
# AI_BREAKER_FAILURES=3
# AI_BREAKER_COOLDOWN_SECONDS=60

# --- 语音合成 TTS：引擎与产物可达基址（M2/D2.3；O-10 已定稿 2026-10-15）---
# --- 统一降级总开关（2026-11-18）---
# false（默认）= 仅本地：DeepSeek / edge-tts / 微信同传 / 云端 ASR 全部硬否决，不建连不重试不探测；
#                  本地 Ollama / FunASR / Qwen3-TTS / 规则模板 / 预生成音频照常工作。
# true = 允许按「能力级 && 供应商级」开关使用外部供应商（全链路）。
AI_DEGRADE_ENABLED=false
AI_DEGRADE_LLM_ENABLED=true
AI_DEGRADE_ASR_ENABLED=true
AI_DEGRADE_TTS_ENABLED=true
AI_DEGRADE_RAG_ENABLED=true
AI_PROVIDER_DEEPSEEK_ENABLED=true
AI_TTS_QWEN3_ENABLED=true
AI_TTS_EDGE_ENABLED=true
AI_WECHAT_SI_ENABLED=true
AI_ASR_CLOUD_ENABLED=false

# --- TTS 引擎与产物可达基址（2026-11-18 改为降级链）---
# 链：qwen3（本地 sidecar）→ edge（微软 Edge 在线朗读）→ 端侧微信同传（仅普通话）。
# 粤语音色映射：yue-female-1→zh-HK-HiuMaanNeural，yue-male-1→zh-HK-WanLungNeural。
AI_TTS_ENGINES=qwen3,edge
# 本地 Qwen3-TTS sidecar（空=未接入；示例 http://127.0.0.1:9000/api/v1/voice）
AI_TTS_QWEN3_ENDPOINT=
AI_TTS_QWEN3_TIMEOUT_SECONDS=42
AI_TTS_EDGE_TIMEOUT_SECONDS=12
# 业务总预算（ai-service）：qwen3 42 + edge 12 + 余量 1；business task-budget 为 60。
AI_TTS_TIMEOUT_SECONDS=55
# 兼容旧单引擎字段（AI_TTS_ENGINES 优先）
AI_TTS_ENGINE=edge
# audioUrl 的**客户端可达基址**：ai-service 仅内网可达（/internal/**），客户端拿不到内网地址，
# 故 base 必须指向「客户端能访问、且已转发 TTS 产物路径」的对外入口；经网关单入口时 = 网关对外域名。
# 不设时落回内网默认 http://127.0.0.1:8001（仅供本机自测，真机不可达）。
AI_TTS_PUBLIC_BASE=
# ⚠️ 云上必须填 https://<网关对外域名>/api/gw（CLOUD.md §3）；留空落回 127.0.0.1 →
#    audioUrl 客户端不可达、TTS 100% 播不出。本地 env.local 保留本机值属正常联调，勿照抄改它。
# 该入口下转发到 ai-service 内部签名通道的公开路径（网关公开通道：/api/gw/tts/audio/{filename}）
AI_TTS_PUBLIC_PATH=/api/gw/tts/audio
# 短期签名密钥：留空则每次启动随机生成（重启后旧音频 URL 失效，符合“短期”语义）
# AI_TTS_URL_SECRET=
# 音色映射（可选，逗号分隔）：业务音色ID=引擎音色，未命中回落到 AI_TTS_DEFAULT_VOICE，不报错。
# 内置 qwen3-female-1 / qwen3-male-1 已在代码里有兜底映射（女声 Xiaoxiao / 男声 Yunxi），
# 这里显式配置用于覆盖默认或新增音色；两个内置音色不要再都指向同一个引擎音色。
# AI_TTS_VOICE_MAP=qwen3-female-1=zh-CN-XiaoxiaoNeural,qwen3-male-1=zh-CN-YunxiNeural
# AI_TTS_DEFAULT_VOICE=zh-CN-XiaoxiaoNeural

# --- AI 内容寻址缓存（M2/D2.4；默认关）---
# 开启后：「同输入+同模型+同模板/策略/音色/参数」的生成类任务（TRIAGE/CHAT/CARE_PLAN）直接复用安全结果，省算力。
# 缓存非权威数据（权威在 MySQL），Redis 缺失时退化为本机 JSON 文件，重启可失。
# AI_CACHE_ENABLED=true
# AI_CACHE_PATH=./runtime/cache.json
# AI_CACHE_TTL_SECONDS=3600
# AI_TENANT_SECRET=          # HMAC 租户密钥；留空则每次启动随机（重启即失效旧条目）
#
# ⚠️ O-03 铁律（权限先于缓存命中，用户裁定 2026-10-15）：
#    ai-service 仅内网 /internal/** 可达，缓存命中发生在 business-service 完成
#    租户隔离/鉴权/角色校验**之后**的任务受理流程内；缓存键本身含 tenantId。
#    不得把缓存下沉到网关或任何对客户端暴露的路径上——否则会绕过鉴权、可被构造同
#    inputDigest 命中越权数据。

# --- 语音识别 ASR（M2/D2.3；默认未配置）---
# AI_ASR_ENGINE=funasr        # none=未配置（→ CAPABILITY_UNAVAILABLE，不伪造转写）/ funasr=本地权重
# AI_ASR_MODEL_PATH=          # FunASR 权重目录（不存在 → 能力如实不可用）
# AI_ASR_AUDIO_DIR=           # 音频引用目录（inputRef=asr:{id} → {id}.wav|mp3|m4a|pcm|ogg|webm）
# AI_ASR_TIMEOUT_SECONDS=25   # 本地快速失败预算：粤语/潮汕不喂普通话模型，超时交给端侧/文字
# AI_ASR_PRELOAD=true         # 启动预热，避免首次请求 30s+ 加载被判超时
#                              ⚠️ 该目录由 business-service（Java）写入、ai-service 只读，
#                              两端读的是同一个 AI_ASR_AUDIO_DIR，值必须一致；不一致 → 取不到音频即降级。

# --- 运行产物回收与保留（M4 硬化前瞻，提前到 M3）---
# 周期清理（sweep）会：① 把超时未终结的任务推进为 EXPIRED；② 裁剪超过保留期的历史任务；
# ③ 回收「未被在库任务引用 + 已过 TTL」的 TTS 产物。全部为**非权威中间态**，回收不影响正确性。
# AI_TASK_RETENTION_SECONDS=86400   # 历史任务保留期（超出即裁剪）
# AI_SWEEP_INTERVAL_SECONDS=60      # 周期清理间隔；0=关闭周期清理（仍有「每 50 任务」兜底裁剪）
# AI_TTS_ARTIFACT_TTL_SECONDS=3600  # TTS 产物保留期（未被引用且超时的 .mp3 才回收）

# --- 网关（可选）---
# GW_LOG_LEVEL=INFO

# --- 网关限流（M4 硬化前瞻，提前到 M3；默认关）---
# 固定窗口限流，按「客户端标识（X-Forwarded-For 首跳 / 直连地址）」计数；定位是保护上游，不是配额计费。
# 探针路径（/health、/api/gw/health）**不参与**限流——否则编排器健康轮询会被自己限死。
# 命中 → 429 + 统一错误信封（code=RATE_LIMITED）+ Retry-After。
# GW_RATE_LIMIT_ENABLED=false
# GW_RATE_LIMIT_PER_MINUTE=300
# GW_RATE_LIMIT_WINDOW_SECONDS=60
# ⚠️ 是否采信 X-Forwarded-For 作为限流键（DEF-13 / 审计 F-01）：
#   false（**默认**，安全默认）= 网关直接暴露给客户端，只用 TCP 对端地址；
#   true = 网关前面确有 frp/Nginx 等**可信**反代会覆盖 XFF。
#   采信可伪造的 XFF 时，客户端每次换一个值就是一个新桶，"伪造 IP 不放行"永远不成立，
#   网关限流与 business 侧 login 限流会同时失效。开启前按实际拓扑选一次，并回归
#   「第 61 次仍 429」与「伪造 XFF 不放行」两条。
# GW_RATE_LIMIT_TRUST_XFF=true

# --- 网关静态素材公开通道（前端适配：素材经后端传递，docs/v4/09 §4.2）---
# 白名单图片经统一入口分发（/api/gw/assets/{filename}，ETag/304 + sha256 头）；
# 目录也可用 config.json.assets.dir（默认 backend/deploy/resources），相对路径以仓库根为基准。
# GW_ASSETS_DIR=backend/deploy/resources

# --- 网关 legacy 兼容登录开关（安全默认关闭）---
# 控制条目 POST /api/user/login（dev 替身：用派生 dev code 换取会话，不做密码校验）。
# **默认 false = 404**：生产严禁开启（x-migration 已声明生产不得使用 dev 合成身份通道）。
# 仅本地/联调环境在 deploy/config.json 显式置 "compat": { "legacyLoginEnabled": true }。
# GW_LEGACY_LOGIN_ENABLED=true

# ============================================================
# 后端常驻守护 + QQ 邮箱告警（2026-11-17 新增）
# ============================================================
# 守护进程 guardian.ps1 定时探活，服务掉线自动重启（orchestrator start，幂等只补缺的），
# 重启失败发告警邮件。启动：双击 start-guardian.bat；状态：status-guardian.bat。
#
# --- 守护行为（都有默认值，可不填）---
# GUARD_INTERVAL_SEC=60        # 巡检间隔秒，最小 10
# GUARD_FAIL_THRESHOLD=2        # 连续 N 次判 DOWN 才重启（防抖动误判）
# GUARD_COOLDOWN_SEC=180        # 两次重启最小间隔秒（防疯狂重启）
# GUARD_LOG_TAIL_LINES=3        # 邮件里每个服务错误日志摘要行数
#
# --- QQ 邮箱告警（要发信则以下 4 项必填，且 ALERT_MAIL_ENABLED=true）---
# ⚠️ 授权码 ≠ QQ 登录密码：在 QQ 邮箱网页版 → 设置 → 账户 → POP3/SMTP 服务 →
#    开启后获取「授权码」（16 位）。把它填进 ALERT_MAIL_AUTH_CODE，不要填登录密码。
# ⚠️ 本文件是模板，真实凭据只写进 env.local（已被 .gitignore 忽略，不入库）。
# ALERT_MAIL_ENABLED=true
# ALERT_MAIL_USER=yourname@qq.com
# ALERT_MAIL_AUTH_CODE=这里填16位授权码
# ALERT_MAIL_TO=收件人@qq.com        # 多个收件人用 ; 或 , 分隔
# --- 可选 ---
# ALERT_MAIL_SMTP_HOST=smtp.qq.com
# ALERT_MAIL_SMTP_PORT=465          # 465 隐式 SSL；若改用 587 需同步置 ALERT_MAIL_SMTP_SSL=true
# ALERT_MAIL_SMTP_SSL=true
# ALERT_MAIL_FROM_NAME=后端守护
# ALERT_MAIL_TIMEOUT_MS=15000
#
# 配置校验（不发信，只渲染正文 + 脱敏配置）：
#   powershell -NoProfile -ExecutionPolicy Bypass -File scripts\mail-alert.ps1 -SelfTest
# 连通性测试（真发一封测试邮件）：
#   powershell -NoProfile -ExecutionPolicy Bypass -File scripts\mail-alert.ps1 -SendTest
