# AI-Service 环境变量配置示例（staging/production）
# 使用方法：复制为 .env.ai-service 并修改实际值
# 注意：此文件不包含敏感信息，.env.ai-service 应加入 .gitignore

# ===== 内容寻址缓存配置（P0 性能优化，2026-10-22） =====

# 缓存开关：true=启用内容寻址缓存，false=关闭（默认）
# staging 建议：true（验证命中率）
# production 建议：true（生产开启，回滚时改 false）
AI_CACHE_ENABLED=true

# 租户密钥：32 字节 hex 串（固定值，重启不变 → 缓存条目可持久复用）
# 生成方法：python -c "import secrets; print(secrets.token_hex(32))"
# 注意：换密钥 = 旧缓存全失效（租户隔离机制）
AI_TENANT_SECRET=请生成32字节hex替换此占位符000000000000000000000000

# 缓存 TTL：单位秒，默认 3600（1 小时）
# staging 建议：600（10 分钟，方便观察过期）
# production 建议：3600 或更长（业务稳定后可延长至 86400=24 小时）
AI_CACHE_TTL_SECONDS=3600

# ===== ASR 模型预热配置（P0 性能优化，2026-10-22） =====

# ASR 模型预热：true=启动时后台加载 ASR 模型，false=首次请求懒加载（默认）
# staging 建议：true（验证预热效果）
# production 建议：true（避免首次请求冷启动 10~30s）
AI_ASR_PRELOAD=true

# ===== Ollama 配置 =====

# Ollama 服务地址（内网）
AI_OLLAMA_URL=http://localhost:11434

# ===== 模型配置 =====

# ASR 引擎：funasr（默认）或 none（关闭）
AI_ASR_ENGINE=funasr

# ASR 模型路径（FunASR 权重目录）
# 示例：/data/models/paraformer-zh
AI_ASR_MODEL_PATH=/path/to/funasr/model

# TTS 引擎：edge（默认，微软免费端点）或 none（关闭）
AI_TTS_ENGINE=edge

# ===== 日志配置 =====

# 日志级别：DEBUG | INFO | WARNING | ERROR
# staging 建议：INFO（观察缓存命中日志）
# production 建议：WARNING（减少日志量）
AI_LOG_LEVEL=INFO

# ===== 其他配置 =====

# 探针超时：单位秒，默认 5
AI_PROBE_TIMEOUT_SECONDS=5

# 任务总超时：单位秒，默认 120
AI_TASK_TIMEOUT_SECONDS=120

# 结果保留时长：单位秒，默认 3600
AI_RESULT_TTL_SECONDS=3600
