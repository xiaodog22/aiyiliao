# =============================================================================
# aiyiliao 安全整改 · 环境变量模板（2026-11-18）
# =============================================================================
# 用法：
#   1) 复制为 backend/deploy/env.local（本地）或注入容器/密钥管理系统（生产）
#   2) 所有 CHANGE_ME 必须替换；<...> 为格式占位，不是值
#   3) 生产禁止把本文件的值直接提交；本文件只含占位符
#   4) 生成命令见文件末尾
# =============================================================================

# -----------------------------------------------------------------------------
# 0. 运行档位（决定所有 fail-closed 分支）
# -----------------------------------------------------------------------------
# prod / dev / itest；生产必须 prod。缺省不要留空。
SPRING_PROFILES_ACTIVE=prod
# ai-service 无独立部署档 env；令牌档由 AI_AUTH_MODE 控制（生产 static）
# 网关配置档：config.json（默认）或显式指定
GW_CONFIG_PATH=backend/deploy/config.json

# -----------------------------------------------------------------------------
# 1. 认证 / 会话（C1 / H3 / H9 / M12 / M13）
# -----------------------------------------------------------------------------
# 业务鉴权档：strict（默认，唯一生产合法值）/ header（仅 itest）/ off（仅 dev 排障）
APP_AUTH_MODE=strict

# dev 登录闸门（生产必须 false / 空）
APP_AUTH_DEV_LOGIN_ENABLED=false
APP_AUTH_DEV_LOGIN_KEY=
# 已泄露 dev key 的吊销清单（Spring 属性 app.auth.dev-login.revoked-keys）
APP_AUTH_DEV_LOGIN_REVOKED_KEYS=
# dev 手输白名单（仅 dev；生产留空）
APP_AUTH_DEV_LOGIN_PHONES=
APP_AUTH_DEV_LOGIN_IDENTITY_MAP=

# 会话策略（M12 / M14）：以下为代码常量，不是 env，改动要发版
#   access 7200s（AuthSessionStore.ACCESS_TTL_SECONDS）、refresh 24h、存活会话上限 3
# 登录限流（H6）：滑动窗口内允许的登录次数
APP_RATE_LIMIT_LOGIN=30

# -----------------------------------------------------------------------------
# 2. 业务密钥（H2 / H7 / M5 / M6）—— 必须来自密钥管理系统
# -----------------------------------------------------------------------------
# 手机号可逆加密密钥（Base64，解码后 32 字节；不要用 dev 的 012345...）
PHONE_KEY_BASE64=CHANGE_ME_BASE64_32_BYTES
# 手机号 HMAC（≥32 字符；与 PHONE_KEY_BASE64 不同值）
APP_PHONE_HMAC_KEY=CHANGE_ME_PHONE_HMAC_32_CHARS_MIN
# 密钥轮换窗口：上一把 HMAC 只读兼容旧行，命中后自动回写当前 key；平时留空
APP_PHONE_HMAC_KEY_PREVIOUS=
# 验证码 HMAC（≥32 字符；与手机号 HMAC 不同值）
APP_CODE_HASH_SECRET=CHANGE_ME_CODE_HASH_32_CHARS_MIN
# 附件签名（≥32 字符）
APP_ATTACHMENT_SIGN_SECRET=CHANGE_ME_ATTACHMENT_SIGN_32_CHARS_MIN
# 头像匿名读取短签（≥32 字符；审计 M5，与附件签名分离）
APP_AVATAR_SIGN_SECRET=CHANGE_ME_AVATAR_SIGN_32_CHARS_MIN
# 当前隐私政策版本（审计 M11；登录携带旧版本 → 409）
APP_CONSENT_VERSION=v1.0
APP_CONSENT_EFFECTIVE_AT=2026-11-18
APP_CONSENT_TITLE=隐私政策
# 语音缓存签名（≥32 字符；VoiceService 读取 VOICE_CACHE_SECRET，未配置会告警并用进程随机值）
VOICE_CACHE_SECRET=CHANGE_ME_VOICE_CACHE_32_CHARS_MIN

# -----------------------------------------------------------------------------
# 3. 数据库（H7）
# -----------------------------------------------------------------------------
MYSQL_URL=jdbc:mysql://mysql:3306/wechar?useUnicode=true&characterEncoding=UTF-8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
MYSQL_DATABASE=wechar
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
# 应用账号必须是 wechar_app，不得 root；两个变量同值（compose 初始化用 DB_PASSWORD，应用连库用 PASSWORD）
MYSQL_DB_PASSWORD=CHANGE_ME_APP_PASSWORD
MYSQL_USER=wechar_app
MYSQL_PASSWORD=CHANGE_ME_APP_PASSWORD

# -----------------------------------------------------------------------------
# 4. 业务 → AI 服务令牌（C3）
# -----------------------------------------------------------------------------
AI_SERVICE_URL=http://ai:8001
# 必须 ≥32 字符；business 与 ai 两侧同值
AI_SERVICE_TOKEN=CHANGE_ME_AI_SERVICE_TOKEN_32_CHARS_MIN
# 业务侧租户边界：business 用它填 X-Tenant-Id；生产必须非 dev 默认值
AI_TENANT_ID=wechar-prod

# -----------------------------------------------------------------------------
# 5. ai-service 认证与出境（C3 / H10）
# -----------------------------------------------------------------------------
# static（生产唯一合法）/ off（仅本机离线排障，禁止生产）
AI_AUTH_MODE=static
# domestic（默认，所有境外 provider 硬否决）/ allow（仅离线排障，生产禁止）
AI_EGRESS_POLICY=domestic
# 总降级开关：false=只用本机能力；true 才允许按能力级/供应商级使用外部服务
AI_DEGRADE_ENABLED=false
# provider 链：domestic 只写 ollama；只有 AI_EGRESS_POLICY=allow 才可加 deepseek
AI_PROVIDER_ORDER=ollama
AI_OLLAMA_URL=http://host.docker.internal:11434
# 仅在 allow + 合规审批通过后可填
AI_DEEPSEEK_API_KEY=
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_DEEPSEEK_MODEL=deepseek-flash

# 日志（H4/M1）
AI_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 6. ai-service 存储 / ASR / TTS（C2 / M2 / M3 / M4）
# -----------------------------------------------------------------------------
AI_STORE_PATH=/app/runtime/tasks.json
# 审计 M2：tasks.json 的 result 正文静态加密；生产必须注入（Fernet，URL-safe base64 32 字节）
AI_STORE_ENCRYPTION_KEY=
AI_CACHE_PATH=/app/runtime/cache.json
AI_CACHE_ENABLED=false
# 缓存键 HMAC；不配则进程随机（重启后旧缓存失效）
AI_TENANT_SECRET=

# ASR 音频：business 写入、ai 只读，两端必须是同一目录
AI_ASR_AUDIO_DIR=/data/asr/audio
AI_ASR_ENGINE=funasr
AI_ASR_MODEL_PATH=
AI_ASR_TIMEOUT_SECONDS=25

# TTS 产物目录与资源上限（M3/M4：仅全局上限，尚无按租户日配额）
AI_TTS_OUTPUT_DIR=/data/tts
AI_TTS_MAX_CHARS=2000
AI_TTS_MAX_DISK_MB=512
AI_TTS_TENANT_PER_MINUTE=6
AI_TTS_TENANT_PER_DAY=200
AI_TTS_ARTIFACT_TTL_SECONDS=3600
AI_TTS_URL_SECRET=
# 单次请求体 1MiB、SSE 连接上限 64 在代码中固定，不是 env：
#   AI_STREAM_MAX_CONNECTIONS 才是真实的 SSE 上限开关
AI_STREAM_MAX_CONNECTIONS=64
AI_STREAM_MAX_CONNECTIONS_PER_TENANT=3
AI_TASK_RETENTION_SECONDS=86400
AI_SWEEP_INTERVAL_SECONDS=60

# -----------------------------------------------------------------------------
# 7. 短信 / 微信（H1 / H8）
# -----------------------------------------------------------------------------
# prod（生产唯一合法值）/ dev（仅 dev/itest）
APP_SMS_PROVIDER=prod
APP_SMS_TTL_SECONDS=300
APP_SMS_COOLDOWN_SECONDS=60
APP_SMS_MAX_ATTEMPTS=5
# 真实短信网关尚未接入：prod 档如实 503（不会假装发送）；禁止填 dev 当生产

WECHAT_MINIPROGRAM_APP_ID=
WECHAT_MINIPROGRAM_APP_SECRET=
WECHAT_MINIPROGRAM_API_BASE_URL=https://api.weixin.qq.com
WECHAT_MINIPROGRAM_CONNECT_TIMEOUT_MS=3000
WECHAT_MINIPROGRAM_READ_TIMEOUT_MS=5000
# 小程序后台 request/downloadFile 合法域名由前端 release 配置，不是后端 env

# -----------------------------------------------------------------------------
# 8. 上传 / 头像 / 资源（M5）
# -----------------------------------------------------------------------------
APP_UPLOAD_DIR=/app/run/uploads
APP_RESOURCES_DIR=/app/resources
# 头像短签 TTL 固定 900s（AvatarStorage 常量），没有 env 可调
# 头像签名密钥用 APP_AVATAR_SIGN_SECRET；附件用 APP_ATTACHMENT_SIGN_SECRET

# -----------------------------------------------------------------------------
# 9. 网关 / 部署（H5 / H6 / H7）
# -----------------------------------------------------------------------------
GW_BUSINESS_URL=http://business:8088
GW_AI_URL=http://ai:8001
GW_PROXY_TIMEOUT_SECONDS=220
GW_RATE_LIMIT_ENABLED=true
GW_RATE_LIMIT_PER_MINUTE=120
GW_RATE_LIMIT_WINDOW_SECONDS=60
# frp 直连场景必须 false；有可信反代时才 true（当前网关没有 XFF IP 白名单 env）
GW_RATE_LIMIT_TRUST_XFF=false
GW_CORS_ENABLED=false
GW_CORS_ALLOW_ORIGINS=
GW_LOG_LEVEL=INFO
GW_LOG_PER_REQUEST=false

# 只绑回环；frp 从本机回环转发。网关端口变量是 GW_PORT，不是 GW_HOST_PORT
GW_PORT=8080
# 生产 compose 不建议发布 DB/业务/AI 端口；本地调试用 docker-compose.local.yml
COMPOSE_FILE=docker-compose.yml

# -----------------------------------------------------------------------------
# 10. frp / 隧道（H8）
# -----------------------------------------------------------------------------
# 仓库内没有读取 FRP_* 的应用代码：frpc 配置由部署机/密钥管理系统维护，不注入应用。
# 生产不得使用临时隧道；凭据只放密钥管理系统，不写入仓库。

# -----------------------------------------------------------------------------
# 11. 前端构建（不在后端 .env 中；由发布流水线生成 env.local.js）
# -----------------------------------------------------------------------------
# miniprogram/config/env.local.js（.gitignore）示例：
# module.exports = {
#   buildEnv: 'production',
#   productionGateway: 'https://<已备案正式域名>',
#   devLoginKey: ''
# }

# =============================================================================
# 生成命令（Linux/macOS；不要把输出提交）
# =============================================================================
# 32 字节 Base64（PHONE_KEY_BASE64）：
#   openssl rand -base64 32
# 32 字符以上 HMAC 密钥（APP_PHONE_HMAC_KEY / APP_CODE_HASH_SECRET /
# APP_ATTACHMENT_SIGN_SECRET / APP_AVATAR_SIGN_SECRET / VOICE_CACHE_SECRET / AI_SERVICE_TOKEN）：
#   openssl rand -hex 32
# 数据库口令：
#   openssl rand -base64 24 | tr -d '/+=' | cut -c1-24
# =============================================================================
